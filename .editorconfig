root = true

# ============================================================
# General
# ============================================================

[*]

charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

# ============================================================
# C#
# ============================================================

[*.cs]

indent_style = space
indent_size = 4
tab_width = 4

# ============================================================
# Braces
# ============================================================

# Always use braces
csharp_prefer_braces = true:warning
dotnet_diagnostic.IDE0011.severity = warning

# Put opening braces on a new line
csharp_new_line_before_open_brace = all

# Always expand blocks/statements
csharp_preserve_single_line_blocks = false
csharp_preserve_single_line_statements = false

# Control-flow blocks
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true

# ============================================================
# New Lines
# ============================================================

# Object initializers
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_after_members_in_object_initializers = true

# Anonymous types
csharp_new_line_before_members_in_anonymous_types = true
csharp_new_line_after_members_in_anonymous_types = true

# Query expressions
csharp_new_line_between_query_expression_clauses = true

# ============================================================
# Indentation
# ============================================================

csharp_indent_block_contents = true
csharp_indent_braces = false

csharp_indent_case_contents = true
csharp_indent_case_contents_when_block = true
csharp_indent_switch_labels = true

csharp_indent_labels = one_less_than_current
csharp_indent_switch_section = true

# ============================================================
# Spaces - General
# ============================================================

csharp_space_after_keywords_in_control_flow_statements = true

# ============================================================
# Method declarations
# ============================================================

csharp_space_between_method_declaration_name_and_open_parenthesis = false
csharp_space_between_method_declaration_parameter_list_parentheses = false
csharp_space_between_method_declaration_empty_parameter_list_parentheses = false

# ============================================================
# Method calls
# ============================================================

csharp_space_between_method_call_name_and_opening_parenthesis = false
csharp_space_between_method_call_parameter_list_parentheses = false
csharp_space_between_method_call_empty_parameter_list_parentheses = false

# ============================================================
# Commas
# ============================================================

csharp_space_after_comma = true
csharp_space_before_comma = false

# ============================================================
# Dots
# ============================================================

csharp_space_after_dot = false
csharp_space_before_dot = false

# ============================================================
# Semicolons
# ============================================================

csharp_space_after_semicolon_in_for_statement = true
csharp_space_before_semicolon_in_for_statement = false

# ============================================================
# Operators
# ============================================================

csharp_space_around_binary_operators = before_and_after

# ============================================================
# Colons
# ============================================================

csharp_space_before_colon_in_inheritance_clause = true
csharp_space_after_colon_in_inheritance_clause = true

# ============================================================
# Casts
# ============================================================

csharp_space_after_cast = false

# ============================================================
# Parentheses
# ============================================================

csharp_space_between_parentheses = false

# ============================================================
# Arrays
# ============================================================

csharp_space_before_open_square_brackets = false
csharp_space_between_square_brackets = false
csharp_space_between_empty_square_brackets = false

# ============================================================
# Expression-bodied members
# ============================================================

# Prefer normal block bodies
csharp_style_expression_bodied_constructors = false:warning
csharp_style_expression_bodied_methods = false:warning
csharp_style_expression_bodied_operators = false:warning
csharp_style_expression_bodied_properties = false:warning
csharp_style_expression_bodied_indexers = false:warning
csharp_style_expression_bodied_accessors = false:warning
csharp_style_expression_bodied_local_functions = false:warning

# ============================================================
# Variables
# ============================================================

# Prefer explicit types
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = false:suggestion
csharp_style_var_elsewhere = false:suggestion

# ============================================================
# Modern C#
# ============================================================

csharp_style_implicit_object_creation_when_type_is_apparent = true:suggestion
csharp_style_prefer_collection_expression = true:suggestion
csharp_style_prefer_index_operator = true:suggestion
csharp_style_prefer_range_operator = true:suggestion
csharp_style_prefer_null_check_over_type_check = true:suggestion

# ============================================================
# Pattern Matching
# ============================================================

csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion
csharp_style_pattern_matching_over_as_with_null_check = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_prefer_not_pattern = true:suggestion

# ============================================================
# Null / Expressions
# ============================================================

csharp_style_throw_expression = true:suggestion
csharp_style_coalesce_expression = true:suggestion
csharp_style_null_propagation = true:suggestion

# ============================================================
# Namespace
# ============================================================

# .NET 10 / modern C#
csharp_style_namespace_declarations = file_scoped:suggestion

# ============================================================
# Accessibility
# ============================================================

dotnet_style_require_accessibility_modifiers = always:warning

# ============================================================
# Qualification
# ============================================================

dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion

# ============================================================
# Object / Collection Initializers
# ============================================================

dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion

# ============================================================
# Using directives
# ============================================================

dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# ============================================================
# Modifier order
# ============================================================

csharp_preferred_modifier_order =
    public,
    private,
    protected,
    internal,
    file,
    static,
    abstract,
    sealed,
    readonly,
    const,
    extern,
    new,
    virtual,
    override,
    partial,
    unsafe,
    volatile,
    async:suggestion

# ============================================================
# Naming
# ============================================================

# Interfaces: ICarService
dotnet_naming_rule.interface_should_be_prefixed_with_i.severity = warning
dotnet_naming_rule.interface_should_be_prefixed_with_i.symbols = interfaces
dotnet_naming_rule.interface_should_be_prefixed_with_i.style = interface_style

dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.interfaces.applicable_accessibilities = *

dotnet_naming_style.interface_style.required_prefix = I
dotnet_naming_style.interface_style.capitalization = pascal_case

# Classes: CarService
dotnet_naming_rule.classes_should_be_pascal_case.severity = warning
dotnet_naming_rule.classes_should_be_pascal_case.symbols = classes
dotnet_naming_rule.classes_should_be_pascal_case.style = pascal_style

dotnet_naming_symbols.classes.applicable_kinds = class
dotnet_naming_symbols.classes.applicable_accessibilities = *

dotnet_naming_style.pascal_style.capitalization = pascal_case

# Methods: GetCarAsync
dotnet_naming_rule.methods_should_be_pascal_case.severity = warning
dotnet_naming_rule.methods_should_be_pascal_case.symbols = methods
dotnet_naming_rule.methods_should_be_pascal_case.style = pascal_style

dotnet_naming_symbols.methods.applicable_kinds = method
dotnet_naming_symbols.methods.applicable_accessibilities = *

# Properties: CarName
dotnet_naming_rule.properties_should_be_pascal_case.severity = warning
dotnet_naming_rule.properties_should_be_pascal_case.symbols = properties
dotnet_naming_rule.properties_should_be_pascal_case.style = pascal_style

dotnet_naming_symbols.properties.applicable_kinds = property
dotnet_naming_symbols.properties.applicable_accessibilities = *

# Private fields: _carRepository
dotnet_naming_rule.private_fields_should_use_underscore.severity = warning
dotnet_naming_rule.private_fields_should_use_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_should_use_underscore.style = private_field_style

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private

dotnet_naming_style.private_field_style.required_prefix = _
dotnet_naming_style.private_field_style.capitalization = camel_case

# Local variables: car
dotnet_naming_rule.locals_should_be_camel_case.severity = suggestion
dotnet_naming_rule.locals_should_be_camel_case.symbols = locals
dotnet_naming_rule.locals_should_be_camel_case.style = camel_style

dotnet_naming_symbols.locals.applicable_kinds = local
dotnet_naming_symbols.locals.applicable_accessibilities = *

dotnet_naming_style.camel_style.capitalization = camel_case

# Parameters: carId
dotnet_naming_rule.parameters_should_be_camel_case.severity = suggestion
dotnet_naming_rule.parameters_should_be_camel_case.symbols = parameters
dotnet_naming_rule.parameters_should_be_camel_case.style = camel_style

dotnet_naming_symbols.parameters.applicable_kinds = parameter
dotnet_naming_symbols.parameters.applicable_accessibilities = *

# ============================================================
# Diagnostics
# ============================================================

# Formatting
dotnet_diagnostic.IDE0055.severity = suggestion

# Braces
dotnet_diagnostic.IDE0011.severity = warning

# ============================================================
# JSON
# ============================================================

[*.json]

indent_style = space
indent_size = 2

# ============================================================
# XML
# ============================================================

[*.xml]

indent_style = space
indent_size = 2

# ============================================================
# YAML
# ============================================================

[*.{yml,yaml}]

indent_style = space
indent_size = 2

# ============================================================
# Razor
# ============================================================

[*.razor]

indent_style = space
indent_size = 4

# ============================================================
# Project files
# ============================================================

[*.csproj]

indent_style = space
indent_size = 2
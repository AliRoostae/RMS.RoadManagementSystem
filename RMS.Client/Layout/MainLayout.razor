@inherits LayoutComponentBase
@implements IDisposable
@inject AuthenticationService Authentication
@inject RmsAuthenticationStateProvider AuthenticationState
@inject NavigationManager Navigation

<div class="admin-shell @(sidebarCollapsed ? "sidebar-collapsed" : null)">
    <aside class="sidebar @(mobileMenuOpen ? "mobile-open" : null)">
        <div class="sidebar-brand">
            <div class="brand-mark"><i class="bi bi-sign-turn-right-fill"></i></div>
            <div class="brand-copy">
                <strong>راه‌بان کیان</strong>
                <small>سامانه مدیریت راه</small>
            </div>
            <button class="icon-button sidebar-close d-lg-none" type="button" @onclick="CloseMobileMenu" aria-label="بستن منو">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <NavMenu OnNavigate="CloseMobileMenu" OnLogout="LogoutAsync" />

        <div class="sidebar-footer">
            <div class="sidebar-support">
                <span class="support-icon"><i class="bi bi-headset"></i></span>
                <div class="brand-copy">
                    <small>نیاز به راهنمایی دارید؟</small>
                    <strong>پشتیبانی سامانه</strong>
                </div>
            </div>
        </div>
    </aside>

    @if (mobileMenuOpen)
    {
        <button type="button" class="sidebar-backdrop" @onclick="CloseMobileMenu" aria-label="بستن منو"></button>
    }

    <div class="main-stage">
        <header class="topbar">
            <div class="topbar-start">
                <button class="icon-button d-lg-none" type="button" @onclick="OpenMobileMenu" aria-label="نمایش منو">
                    <i class="bi bi-list"></i>
                </button>
                <button class="icon-button d-none d-lg-inline-flex" type="button" @onclick="ToggleSidebar" aria-label="جمع کردن منو">
                    <i class="bi @(sidebarCollapsed ? "bi-layout-sidebar-inset" : "bi-layout-sidebar-inset-reverse")"></i>
                </button>
                <div class="topbar-search d-none d-md-flex">
                    <i class="bi bi-search"></i>
                    <input aria-label="جست‌وجوی سراسری" placeholder="جست‌وجوی سراسری نیازمند API" disabled />
                    <i class="bi bi-lock"></i>
                </div>
            </div>

            <div class="topbar-actions">
                <button class="icon-button notification-button" type="button" aria-label="اعلان‌ها" title="API اعلان‌ها هنوز پیاده‌سازی نشده است" disabled>
                    <i class="bi bi-bell"></i>
                </button>
                <div class="topbar-separator"></div>
                <div class="user-summary" title="@CurrentUser?.MobileNumber">
                    <div class="user-meta d-none d-sm-flex">
                        <strong>@GetDisplayName()</strong>
                        <small>@GetRoleLabel()</small>
                    </div>
                    <div class="user-avatar">@GetInitials()</div>
                    <button class="user-logout-button d-none d-sm-inline-grid" type="button" @onclick="LogoutAsync" title="خروج از سامانه" aria-label="خروج از سامانه">
                        <i class="bi bi-box-arrow-right"></i>
                    </button>
                </div>
            </div>
        </header>

        <main class="content-area">
            @Body
        </main>

        <footer class="app-footer">
            <span>راه‌بان کیان · سامانه مدیریت هوشمند راه‌ها</span>
            <span>نسخه ۱.۰ · متصل به RMS.Api</span>
        </footer>
    </div>
</div>

@code {
    private bool sidebarCollapsed;
    private bool mobileMenuOpen;
    private UserResponse? CurrentUser => AuthenticationState.CurrentUser;

    protected override async Task OnInitializedAsync()
    {
        AuthenticationState.AuthenticationStateChanged += HandleAuthenticationStateChanged;
        try
        {
            await Authentication.RefreshCurrentUserAsync();
        }
        catch (ApiClientException)
        {
            // اطلاعات ذخیره‌شده نشست برای نمایش پوسته کافی است؛ خطای شبکه داخل صفحات نمایش داده می‌شود.
        }
        catch (HttpRequestException)
        {
            // در قطعی موقت API، نشست معتبر محلی حفظ می‌شود.
        }
    }

    private void HandleAuthenticationStateChanged(Task<AuthenticationState> authenticationStateTask) =>
        _ = InvokeAsync(StateHasChanged);

    private async Task LogoutAsync()
    {
        await Authentication.LogoutAsync();
        Navigation.NavigateTo("/login", replace: true);
    }

    private string GetDisplayName() => CurrentUser is null
        ? "کاربر سامانه"
        : $"{CurrentUser.FirstName} {CurrentUser.LastName}".Trim();

    private string GetInitials()
    {
        if (CurrentUser is null)
            return "ک";
        return $"{CurrentUser.FirstName.FirstOrDefault()}{CurrentUser.LastName.FirstOrDefault()}";
    }

    private string GetRoleLabel() => CurrentUser?.Role switch
    {
        UserRole.Administrator => "مدیر ارشد سامانه",
        UserRole.Manager => "مدیر",
        UserRole.User => "کاربر",
        _ => "حساب کاربری"
    };

    private void ToggleSidebar() => sidebarCollapsed = !sidebarCollapsed;
    private void OpenMobileMenu() => mobileMenuOpen = true;
    private void CloseMobileMenu() => mobileMenuOpen = false;

    public void Dispose() =>
        AuthenticationState.AuthenticationStateChanged -= HandleAuthenticationStateChanged;
}

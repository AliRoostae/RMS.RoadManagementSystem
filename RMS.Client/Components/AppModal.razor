@if (IsOpen)
{
    <div class="modal-layer" role="presentation" @onkeydown="HandleKeyDown" tabindex="-1">
        <button type="button" class="modal-backdrop-custom" @onclick="RequestClose" aria-label="بستن"></button>
        <section class="app-modal @(Large ? "modal-large" : null)" role="dialog" aria-modal="true" aria-labelledby="app-modal-title">
            <header class="app-modal-header">
                <div>
                    <div class="modal-icon"><i class="bi @Icon"></i></div>
                    <div>
                        <h2 id="app-modal-title">@Title</h2>
                        @if (!string.IsNullOrWhiteSpace(Subtitle))
                        {
                            <p>@Subtitle</p>
                        }
                    </div>
                </div>
                <button type="button" class="icon-button" @onclick="RequestClose" aria-label="بستن پنجره"><i class="bi bi-x-lg"></i></button>
            </header>
            <div class="app-modal-body">@ChildContent</div>
            @if (Footer is not null)
            {
                <footer class="app-modal-footer">@Footer</footer>
            }
        </section>
    </div>
}



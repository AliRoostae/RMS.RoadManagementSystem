@implements IDisposable

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="app-alert danger"><i class="bi bi-exclamation-circle"></i><span>@ErrorMessage</span></div>
}
@if (!string.IsNullOrWhiteSpace(SuccessMessage))
{
    <div class="app-alert success"><i class="bi bi-check2-circle"></i><span>@SuccessMessage</span></div>
}

<section class="panel-card">
    <div class="panel-toolbar">
        <div class="search-field">
            <i class="bi bi-search"></i>
            <input value="@searchTerm" @oninput="OnSearchInputAsync" placeholder="@SearchPlaceholder" />
        </div>
        <div class="toolbar-actions">
            @if (ToolbarContent is not null)
            {
                @ToolbarContent
            }
            <button class="btn btn-light app-button" type="button" @onclick="ReloadAsync" disabled="@IsLoading">
                <i class="bi bi-arrow-clockwise"></i> تازه‌سازی
            </button>
        </div>
    </div>

    <div class="table-responsive">
        <table class="app-table">
            <thead>
                <tr>
                    <th class="index-cell">ردیف</th>
                    @foreach (var column in Columns)
                    {
                        <th class="@column.CssClass">@column.Title</th>
                    }
                    <th>وضعیت</th>
                    <th class="actions-cell entity-actions-cell">عملیات</th>
                </tr>
            </thead>
            <tbody>
                @if (IsLoading)
                {
                    <tr><td colspan="@(Columns.Count + 3)"><div class="table-loading"><span class="spinner-border spinner-border-sm"></span> در حال دریافت اطلاعات از API...</div></td></tr>
                }
                else if (Rows.Count == 0)
                {
                    <tr><td colspan="@(Columns.Count + 3)"><div class="empty-inline"><i class="bi bi-inbox"></i> رکوردی از API دریافت نشد.</div></td></tr>
                }
                else
                {
                    var index = currentPage * PageSize;
                    @foreach (var row in Rows)
                    {
                        index++;
                        <tr>
                            <td class="index-cell">@ToPersian(index)</td>
                            @foreach (var column in Columns)
                            {
                                <td class="@column.CssClass">@GetValue(row, column.Key)</td>
                            }
                            <td><span class="status-badge @row.StatusTone"><span></span>@row.Status</span></td>
                            <td class="actions-cell entity-actions-cell">
                                @if (RowActions is not null)
                                {
                                    <div class="entity-row-actions">@RowActions(row)</div>
                                }
                                else
                                {
                                    <span class="muted-value">—</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="panel-pagination">
        <span>نمایش @ToPersian(Rows.Count) رکورد از @ToPersian(TotalCount) رکورد</span>
        <div class="pagination-buttons">
            <button type="button" title="صفحه قبل" disabled="@(currentPage == 0 || IsLoading)" @onclick="PreviousPageAsync"><i class="bi bi-chevron-right"></i></button>
            <button type="button" class="active">@ToPersian(currentPage + 1)</button>
            <button type="button" title="صفحه بعد" disabled="@(currentPage >= PageCount - 1 || IsLoading)" @onclick="NextPageAsync"><i class="bi bi-chevron-left"></i></button>
        </div>
    </div>
</section>



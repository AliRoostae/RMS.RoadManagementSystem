@inject NavigationManager Navigation
@inject RmsAuthenticationStateProvider AuthenticationState

<nav class="sidebar-nav" aria-label="منوی اصلی">
    <div class="nav-section-label">منوی اصلی</div>
    <NavLink href="/" Match="NavLinkMatch.All" class="nav-item" @onclick="HandleNavigate">
        <i class="bi bi-grid-1x2-fill"></i><span>داشبورد</span>
    </NavLink>
    @if (CanAccess(UserSection.Accidents))
    {
        <div class="nav-parent-row">
            <NavLink href="/accidents" class="nav-item" @onclick="HandleNavigate"><i class="bi bi-exclamation-octagon"></i><span>حوادث</span></NavLink>
            <button type="button" class="nav-submenu-toggle" aria-label="نمایش یا جمع‌کردن اطلاعات وابسته" aria-expanded="@IsAccidentsMenuOpen" @onclick="ToggleAccidentsMenu">
                <i class="bi @(IsAccidentsMenuOpen ? "bi-chevron-down" : "bi-chevron-left")"></i>
            </button>
        </div>
        @if (IsAccidentsMenuOpen)
        {
            <div class="nav-section-label nav-subsection-label">اطلاعات وابسته</div>
            @if (CanAccess(UserSection.Cars))
            {
                <NavLink href="/cars" class="nav-item nav-item-child" @onclick="HandleNavigate"><i class="bi bi-car-front"></i><span>خودروها</span></NavLink>
            }
            @if (CanAccess(UserSection.Passengers))
            {
                <NavLink href="/passengers" class="nav-item nav-item-child" @onclick="HandleNavigate"><i class="bi bi-people"></i><span>رانندگان و سرنشینان</span></NavLink>
            }
            @if (CanAccess(UserSection.People))
            {
                <NavLink href="/people" class="nav-item nav-item-child" @onclick="HandleNavigate"><i class="bi bi-person-walking"></i><span>عابر</span></NavLink>
            }
            @if (CanAccess(UserSection.Images))
            {
                <NavLink href="/images" class="nav-item nav-item-child" @onclick="HandleNavigate"><i class="bi bi-images"></i><span>تصاویر حوادث</span></NavLink>
            }
        }
    }
    @if (CanAccess(UserSection.Roads))
    {
        <NavLink href="/roads" class="nav-item" @onclick="HandleNavigate"><i class="bi bi-map"></i><span>راه‌ها و محدوده‌ها</span></NavLink>
    }

    <div class="nav-section-label">مدیریت و تحلیل</div>
    @if (CanAccess(UserSection.Reports))
    {
        <NavLink href="/reports" class="nav-item" @onclick="HandleNavigate"><i class="bi bi-bar-chart-line"></i><span>گزارش‌ها</span></NavLink>
        @if (HasReportAccess(UserSection.Cars))
        {
        <NavLink href="/reports/cars" class="nav-item nav-item-child" @onclick="HandleNavigate"><i class="bi bi-car-front"></i><span>گزارش خودروها</span></NavLink>
        <NavLink href="/reports/humans" class="nav-item nav-item-child" @onclick="HandleNavigate"><i class="bi bi-people"></i><span>گزارش افراد</span></NavLink>
        }
        @if (HasReportAccess(UserSection.Accidents))
        {
        <NavLink href="/reports/accidents" class="nav-item nav-item-child" @onclick="HandleNavigate"><i class="bi bi-list-columns-reverse"></i><span>گزارش حوادث</span></NavLink>
        <NavLink href="/reports/accidents/map" class="nav-item nav-item-child" @onclick="HandleNavigate"><i class="bi bi-geo-alt"></i><span>نقشه حوادث</span></NavLink>
        }
    }
    @if (CanAccess(UserSection.Users))
    {
        <NavLink href="/users" class="nav-item" @onclick="HandleNavigate"><i class="bi bi-person-gear"></i><span>کاربران و دسترسی</span></NavLink>
    }

    <div class="nav-section-label">حساب کاربری</div>
    <button type="button" class="nav-item nav-item-button nav-item-danger" @onclick="HandleLogout">
        <i class="bi bi-box-arrow-right"></i><span>خروج از سامانه</span>
    </button>
</nav>



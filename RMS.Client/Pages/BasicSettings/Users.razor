@page "/users"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@inject UserApiService UserApi
@inject AuthenticationService Authentication
@inject RmsAuthenticationStateProvider AuthenticationState

<PageTitle>کاربران و دسترسی‌ها | راه‌بان کیان</PageTitle>

<PageHeader Title="کاربران و دسترسی‌ها" Eyebrow="مدیریت سامانه"
            Description="تعریف کاربران، نقش‌ها و سطح دسترسی آن‌ها بر اساس مجوزهای RMS.Api">
    <Actions>
        <button class="btn btn-light app-button" type="button" @onclick="ReloadAsync" disabled="@isLoading">
            <i class="bi bi-arrow-clockwise"></i> به‌روزرسانی
        </button>
        @if (CanCreate)
        {
            <button class="btn btn-primary app-button" type="button" @onclick="OpenCreate">
                <i class="bi bi-person-plus"></i> افزودن کاربر
            </button>
        }
    </Actions>
</PageHeader>

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="app-alert success" role="status"><i class="bi bi-check-circle"></i><span>@successMessage</span></div>
}
@if (!string.IsNullOrWhiteSpace(pageError))
{
    <div class="app-alert danger" role="alert"><i class="bi bi-exclamation-circle"></i><span>@pageError</span></div>
}

@if (!CanList)
{
    <section class="panel-card access-denied-card">
        <span><i class="bi bi-shield-lock"></i></span>
        <h2>دسترسی به فهرست کاربران محدود است</h2>
        <p>برای مشاهده این صفحه، مجوز گزارش کاربران لازم است.</p>
    </section>
}
else
{
    <section class="panel-card">
        <div class="panel-toolbar users-toolbar">
            <div class="search-field">
                <i class="bi bi-search"></i>
                <input @bind="searchTerm" @bind:event="oninput" @onkeydown="HandleSearchKeyDown" placeholder="جست‌وجو با نام، نام خانوادگی یا شماره موبایل..." />
            </div>
            <div class="toolbar-actions users-filter-actions">
                <select class="compact-select role-filter" @bind="roleFilter" aria-label="فیلتر نقش">
                    <option value="">همه نقش‌ها</option>
                    @foreach (var role in Enum.GetValues<UserRole>())
                    {
                        <option value="@role">@GetRoleLabel(role)</option>
                    }
                </select>
                <button class="btn btn-light app-button" type="button" @onclick="ApplyFiltersAsync" disabled="@isLoading">
                    <i class="bi bi-funnel"></i> اعمال فیلتر
                </button>
            </div>
        </div>

        <div class="table-responsive">
            <table class="app-table users-table">
                <thead>
                    <tr>
                        <th>کاربر</th>
                        <th>شماره موبایل</th>
                        <th>نقش</th>
                        <th>دسترسی‌ها</th>
                        <th class="actions-cell">عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (isLoading)
                    {
                        <tr><td colspan="5"><div class="table-loading"><span class="spinner-border spinner-border-sm"></span> در حال دریافت کاربران از API...</div></td></tr>
                    }
                    else if (users.Count == 0)
                    {
                        <tr><td colspan="5"><div class="empty-inline"><i class="bi bi-person-x"></i> کاربری با این معیارها پیدا نشد.</div></td></tr>
                    }
                    else
                    {
                        @foreach (var user in users)
                        {
                            <tr>
                                <td>
                                    <div class="user-table-identity">
                                        <span class="table-avatar">@GetInitials(user)</span>
                                        <div><strong>@user.FirstName @user.LastName</strong><small>@GetUserSubtitle(user)</small></div>
                                    </div>
                                </td>
                                <td><span class="ltr-value">@user.MobileNumber</span></td>
                                <td><span class="role-badge @GetRoleTone(user.Role)">@GetRoleLabel(user.Role)</span></td>
                                <td>
                                    @if (user.Role == UserRole.Administrator)
                                    {
                                        <span class="permission-summary all"><i class="bi bi-shield-check"></i> دسترسی کامل</span>
                                    }
                                    else if (user.PermissionSectionCount == 0)
                                    {
                                        <span class="permission-summary none">بدون دسترسی صریح</span>
                                    }
                                    else
                                    {
                                        <span class="permission-summary"><i class="bi bi-key"></i> @ToPersian(user.PermissionSectionCount) بخش</span>
                                    }
                                </td>
                                <td class="actions-cell">
                                    @if (CanView)
                                    {
                                        <button type="button" class="table-action" title="مشاهده و ویرایش" @onclick="() => OpenEditAsync(user.Id)">
                                            <i class="bi @(CanUpdate ? "bi-pencil-square" : "bi-eye")"></i>
                                        </button>
                                    }
                                    @if (CanDelete)
                                    {
                                        <button type="button" class="table-action danger" title="حذف کاربر"
                                                disabled="@(AuthenticationState.CurrentUser?.Id == user.Id)" @onclick="() => AskDelete(user)">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="panel-pagination">
            <span>صفحه @ToPersian(pageIndex + 1) از @ToPersian(PageCount) · مجموع @ToPersian(totalCount) کاربر</span>
            <div class="pagination-buttons">
                <button type="button" disabled="@(pageIndex == 0 || isLoading)" @onclick="PreviousPageAsync"><i class="bi bi-chevron-right"></i></button>
                <button type="button" class="active">@ToPersian(pageIndex + 1)</button>
                <button type="button" disabled="@(!hasNextPage || isLoading)" @onclick="NextPageAsync"><i class="bi bi-chevron-left"></i></button>
            </div>
        </div>
    </section>
}

<AppModal IsOpen="editorOpen" Large="true" Title="@(editingUserId.HasValue ? "ویرایش کاربر" : "افزودن کاربر")"
          Subtitle="مشخصات حساب و مجوزهای دسترسی را تعیین کنید." Icon="bi-person-gear" OnClose="CloseEditor">
    <ChildContent>
        @if (isLoadingEditor)
        {
            <div class="table-loading"><span class="spinner-border spinner-border-sm"></span> در حال دریافت اطلاعات کاربر...</div>
        }
        else
        {
            @if (!string.IsNullOrWhiteSpace(editorError))
            {
                <div class="app-alert danger" role="alert"><i class="bi bi-exclamation-circle"></i><span>@editorError</span></div>
            }
            <EditForm id="user-editor-form" Model="editor" OnValidSubmit="SaveUserAsync">
                <DataAnnotationsValidator />
                <div class="form-grid">
                    <div class="form-group">
                        <label for="first-name">نام</label>
                        <InputText id="first-name" @bind-Value="editor.FirstName" placeholder="نام کاربر" disabled="@(!CanSaveEditor || isSaving)" />
                        <ValidationMessage For="() => editor.FirstName" />
                    </div>
                    <div class="form-group">
                        <label for="last-name">نام خانوادگی</label>
                        <InputText id="last-name" @bind-Value="editor.LastName" placeholder="نام خانوادگی" disabled="@(!CanSaveEditor || isSaving)" />
                        <ValidationMessage For="() => editor.LastName" />
                    </div>
                    <div class="form-group">
                        <label for="user-mobile">شماره موبایل</label>
                        <InputText id="user-mobile" inputmode="tel" dir="ltr" @bind-Value="editor.MobileNumber" placeholder="09121234567" disabled="@(!CanSaveEditor || isSaving)" />
                        <ValidationMessage For="() => editor.MobileNumber" />
                    </div>
                    <div class="form-group">
                        <label for="user-role">نقش کاربر</label>
                        <InputSelect id="user-role" @bind-Value="editor.Role" disabled="@(!CanSaveEditor || isSaving)">
                            @foreach (var role in AvailableRoles)
                            {
                                <option value="@role">@GetRoleLabel(role)</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="form-group">
                        <label for="user-password">@(editingUserId.HasValue ? "رمز عبور جدید" : "رمز عبور")</label>
                        <InputText id="user-password" type="password" autocomplete="new-password" @bind-Value="editor.Password"
                                   placeholder="@(editingUserId.HasValue ? "برای عدم تغییر، خالی بگذارید" : "حداقل ۶ کاراکتر")" disabled="@(!CanSaveEditor || isSaving)" />
                    </div>
                    <div class="form-group">
                        <label for="confirm-password">تکرار رمز عبور</label>
                        <InputText id="confirm-password" type="password" autocomplete="new-password" @bind-Value="editor.ConfirmPassword"
                                   placeholder="تکرار رمز عبور" disabled="@(!CanSaveEditor || isSaving)" />
                    </div>
                </div>

                <div class="permission-editor">
                    <div class="permission-editor-heading">
                        <div><h3>مجوزهای دسترسی</h3><p>عملیات مجاز کاربر را برای هر بخش مشخص کنید.</p></div>
                        @if (editor.Role == UserRole.Administrator)
                        {
                            <span class="role-override-note"><i class="bi bi-shield-check"></i> مدیر ارشد مستقل از انتخاب‌های زیر دسترسی کامل دارد.</span>
                        }
                    </div>

                    @if (metadata is null)
                    {
                        <div class="metadata-warning"><i class="bi bi-exclamation-triangle"></i> metadata دسترسی‌ها از API دریافت نشده است.</div>
                    }
                    else
                    {
                        <div class="permission-table-wrap">
                            <table class="permission-table">
                                <thead>
                                    <tr>
                                        <th>بخش سامانه</th>
                                        @foreach (var operation in AvailableOperations)
                                        {
                                            <th>@GetOperationLabel(operation)</th>
                                        }
                                        <th>همه</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var section in AvailableSections)
                                    {
                                        <tr>
                                            <td><span class="section-name"><i class="bi @GetSectionIcon(section)"></i>@GetSectionLabel(section)</span></td>
                                            @foreach (var operation in AvailableOperations)
                                            {
                                                <td><input type="checkbox" checked="@HasEditorPermission(section, operation)"
                                                           disabled="@(!CanSaveEditor || isSaving)" @onchange="e => SetEditorPermission(section, operation, IsChecked(e))" /></td>
                                            }
                                            <td><input type="checkbox" checked="@HasAllEditorPermissions(section)"
                                                       disabled="@(!CanSaveEditor || isSaving)" @onchange="e => SetAllEditorPermissions(section, IsChecked(e))" /></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </EditForm>
        }
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-light app-button" @onclick="CloseEditor" disabled="@isSaving">بستن</button>
        @if (CanSaveEditor && !isLoadingEditor)
        {
            <button type="submit" form="user-editor-form" class="btn btn-primary app-button" disabled="@isSaving">
                @if (isSaving)
                {
                    <span class="spinner-border spinner-border-sm"></span><span>در حال ذخیره...</span>
                }
                else
                {
                    <i class="bi bi-check2-circle"></i><span>ذخیره اطلاعات</span>
                }
            </button>
        }
    </Footer>
</AppModal>

<AppModal IsOpen="deleteModalOpen" Title="حذف کاربر" Subtitle="این عملیات قابل بازگشت نیست." Icon="bi-trash3" OnClose="CloseDeleteModal">
    <ChildContent>
        <div class="delete-confirmation">
            <span><i class="bi bi-exclamation-triangle"></i></span>
            <div>
                <strong>آیا از حذف «@deletingUser?.FirstName @deletingUser?.LastName» مطمئن هستید؟</strong>
                <p>حساب این کاربر و تمام دسترسی‌های ثبت‌شده برای او حذف خواهد شد.</p>
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(deleteError))
        {
            <div class="app-alert danger"><i class="bi bi-exclamation-circle"></i><span>@deleteError</span></div>
        }
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-light app-button" @onclick="CloseDeleteModal" disabled="@isDeleting">انصراف</button>
        <button type="button" class="btn btn-danger app-button" @onclick="DeleteUserAsync" disabled="@isDeleting">
            @if (isDeleting)
            {
                <span class="spinner-border spinner-border-sm"></span><span>در حال حذف...</span>
            }
            else
            {
                <i class="bi bi-trash3"></i><span>حذف کاربر</span>
            }
        </button>
    </Footer>
</AppModal>

@code {
    private const int PageSize = 20;
    private readonly List<UserListItemResponse> users = [];
    private readonly Dictionary<UserSection, UserAccessOperation> editorPermissions = [];
    private AccessMetadataResponse? metadata;
    private UserEditorModel editor = new();
    private Guid? editingUserId;
    private UserListItemResponse? deletingUser;
    private string searchTerm = string.Empty;
    private UserRole? roleFilter;
    private int pageIndex;
    private int totalCount;
    private bool hasNextPage;
    private bool isLoading = true;
    private bool editorOpen;
    private bool isLoadingEditor;
    private bool isSaving;
    private bool deleteModalOpen;
    private bool isDeleting;
    private string? pageError;
    private string? successMessage;
    private string? editorError;
    private string? deleteError;

    private bool CanList => AuthenticationState.HasPermission(UserSection.Users, UserAccessOperation.Report);
    private bool CanView => AuthenticationState.HasPermission(UserSection.Users, UserAccessOperation.View);
    private bool CanCreate => AuthenticationState.HasPermission(UserSection.Users, UserAccessOperation.Create);
    private bool CanUpdate => AuthenticationState.HasPermission(UserSection.Users, UserAccessOperation.View)
        && AuthenticationState.HasPermission(UserSection.Users, UserAccessOperation.Update);
    private bool CanDelete => AuthenticationState.HasPermission(UserSection.Users, UserAccessOperation.Delete);
    private bool CanSaveEditor => editingUserId.HasValue ? CanUpdate : CanCreate;
    private int PageCount => Math.Max(1, (int)Math.Ceiling(totalCount / (double)PageSize));

    private IEnumerable<UserRole> AvailableRoles => metadata?.Roles
        .Select(item => (UserRole)item.Id)
        .Where(Enum.IsDefined) ?? Enum.GetValues<UserRole>();

    private IEnumerable<UserSection> AvailableSections => metadata?.Sections
        .Select(item => (UserSection)item.Id)
        .Where(Enum.IsDefined) ?? [];

    private IEnumerable<UserAccessOperation> AvailableOperations => metadata?.Operations
        .Select(item => (UserAccessOperation)item.Id)
        .Where(operation => operation != UserAccessOperation.None) ?? [];

    protected override async Task OnInitializedAsync()
    {
        if (!CanList)
        {
            isLoading = false;
            return;
        }

        await LoadMetadataAsync();
        await LoadUsersAsync();
    }

    private async Task LoadMetadataAsync()
    {
        if (!CanView)
            return;

        try
        {
            metadata = await UserApi.GetAccessMetadataAsync();
        }
        catch (Exception exception) when (exception is ApiClientException or HttpRequestException)
        {
            pageError = GetErrorMessage(exception, "دریافت نقش‌ها و دسترسی‌ها با خطا مواجه شد.");
        }
    }

    private async Task LoadUsersAsync()
    {
        isLoading = true;
        pageError = null;
        try
        {
            var result = await UserApi.GetAllAsync(new UserQuery
            {
                SearchTerm = searchTerm,
                Role = roleFilter,
                Skip = pageIndex * PageSize,
                Take = PageSize
            });
            users.Clear();
            users.AddRange(result.Items);
            totalCount = result.TotalCount;
            hasNextPage = (pageIndex + 1) * PageSize < totalCount;
        }
        catch (Exception exception) when (exception is ApiClientException or HttpRequestException)
        {
            pageError = GetErrorMessage(exception, "دریافت فهرست کاربران با خطا مواجه شد.");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ReloadAsync()
    {
        successMessage = null;
        await LoadUsersAsync();
    }

    private async Task ApplyFiltersAsync()
    {
        pageIndex = 0;
        successMessage = null;
        await LoadUsersAsync();
    }

    private async Task HandleSearchKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
            await ApplyFiltersAsync();
    }

    private async Task PreviousPageAsync()
    {
        if (pageIndex == 0)
            return;
        pageIndex--;
        await LoadUsersAsync();
    }

    private async Task NextPageAsync()
    {
        if (!hasNextPage)
            return;
        pageIndex++;
        await LoadUsersAsync();
    }

    private void OpenCreate()
    {
        editor = new UserEditorModel { Role = UserRole.User };
        editingUserId = null;
        editorPermissions.Clear();
        editorError = metadata is null ? "اطلاعات نقش‌ها و دسترسی‌ها هنوز از API دریافت نشده است." : null;
        isLoadingEditor = false;
        editorOpen = true;
    }

    private async Task OpenEditAsync(Guid id)
    {
        editorOpen = true;
        isLoadingEditor = true;
        editorError = null;
        editingUserId = id;
        editorPermissions.Clear();
        try
        {
            var user = await UserApi.GetByIdAsync(id);
            editor = new UserEditorModel
            {
                FirstName = user.FirstName,
                LastName = user.LastName,
                MobileNumber = user.MobileNumber,
                Role = user.Role
            };
            foreach (var permission in user.Permissions)
                editorPermissions[permission.Section] = permission.Operations;
        }
        catch (Exception exception) when (exception is ApiClientException or HttpRequestException)
        {
            editorError = GetErrorMessage(exception, "دریافت اطلاعات کاربر با خطا مواجه شد.");
        }
        finally
        {
            isLoadingEditor = false;
        }
    }

    private void CloseEditor()
    {
        if (!isSaving)
            editorOpen = false;
    }

    private async Task SaveUserAsync()
    {
        editorError = ValidatePasswords();
        if (editorError is not null)
            return;

        isSaving = true;
        try
        {
            var permissions = editorPermissions
                .Where(item => item.Value != UserAccessOperation.None)
                .Select(item => new UserPermissionCommand { Section = item.Key, Operations = item.Value })
                .ToArray();

            if (editingUserId.HasValue)
            {
                await UserApi.UpdateAsync(editingUserId.Value, new UpdateUserCommand
                {
                    Id = editingUserId.Value,
                    FirstName = editor.FirstName,
                    LastName = editor.LastName,
                    MobileNumber = editor.MobileNumber,
                    Password = string.IsNullOrWhiteSpace(editor.Password) ? null : editor.Password,
                    Role = editor.Role,
                    Permissions = permissions
                });

                if (AuthenticationState.CurrentUser?.Id == editingUserId.Value)
                    await Authentication.RefreshCurrentUserAsync();
                successMessage = "اطلاعات کاربر با موفقیت ویرایش شد.";
            }
            else
            {
                await UserApi.CreateAsync(new CreateUserCommand
                {
                    FirstName = editor.FirstName,
                    LastName = editor.LastName,
                    MobileNumber = editor.MobileNumber,
                    Password = editor.Password!,
                    Role = editor.Role,
                    Permissions = permissions
                });
                pageIndex = 0;
                successMessage = "کاربر جدید با موفقیت ثبت شد.";
            }

            editorOpen = false;
            await LoadUsersAsync();
        }
        catch (Exception exception) when (exception is ApiClientException or HttpRequestException)
        {
            editorError = GetErrorMessage(exception, "ذخیره اطلاعات کاربر با خطا مواجه شد.");
        }
        finally
        {
            isSaving = false;
        }
    }

    private string? ValidatePasswords()
    {
        if (!editingUserId.HasValue && string.IsNullOrWhiteSpace(editor.Password))
            return "برای کاربر جدید وارد کردن رمز عبور الزامی است.";
        if (!string.IsNullOrWhiteSpace(editor.Password) && editor.Password.Length < 6)
            return "رمز عبور باید حداقل ۶ کاراکتر داشته باشد.";
        if (!string.Equals(editor.Password, editor.ConfirmPassword, StringComparison.Ordinal))
            return "رمز عبور و تکرار آن یکسان نیستند.";
        return null;
    }

    private void AskDelete(UserListItemResponse user)
    {
        deletingUser = user;
        deleteError = null;
        deleteModalOpen = true;
    }

    private void CloseDeleteModal()
    {
        if (!isDeleting)
            deleteModalOpen = false;
    }

    private async Task DeleteUserAsync()
    {
        if (deletingUser is null)
            return;

        isDeleting = true;
        deleteError = null;
        try
        {
            await UserApi.DeleteAsync(deletingUser.Id);
            deleteModalOpen = false;
            successMessage = "کاربر با موفقیت حذف شد.";
            if (users.Count == 1 && pageIndex > 0)
                pageIndex--;
            await LoadUsersAsync();
        }
        catch (Exception exception) when (exception is ApiClientException or HttpRequestException)
        {
            deleteError = GetErrorMessage(exception, "حذف کاربر با خطا مواجه شد.");
        }
        finally
        {
            isDeleting = false;
        }
    }

    private bool HasEditorPermission(UserSection section, UserAccessOperation operation) =>
        editorPermissions.TryGetValue(section, out var current) && (current & operation) == operation;

    private bool HasAllEditorPermissions(UserSection section) =>
        AvailableOperations.All(operation => HasEditorPermission(section, operation));

    private void SetEditorPermission(UserSection section, UserAccessOperation operation, bool enabled)
    {
        var current = editorPermissions.GetValueOrDefault(section, UserAccessOperation.None);
        var updated = enabled ? current | operation : current & ~operation;
        if (updated == UserAccessOperation.None)
            editorPermissions.Remove(section);
        else
            editorPermissions[section] = updated;
    }

    private void SetAllEditorPermissions(UserSection section, bool enabled)
    {
        if (!enabled)
        {
            editorPermissions.Remove(section);
            return;
        }
        editorPermissions[section] = AvailableOperations.Aggregate(
            UserAccessOperation.None,
            (current, operation) => current | operation);
    }

    private static bool IsChecked(ChangeEventArgs args) => args.Value is true;

    private static string GetErrorMessage(Exception exception, string fallback) => exception switch
    {
        ApiClientException apiException => apiException.Message,
        HttpRequestException => "ارتباط با RMS.Api برقرار نشد. از اجرا بودن سرویس مطمئن شوید.",
        _ => fallback
    };

    private static string GetInitials(UserListItemResponse user) =>
        $"{user.FirstName.FirstOrDefault()}{user.LastName.FirstOrDefault()}";

    private static string GetUserSubtitle(UserListItemResponse user) =>
        user.Id == Guid.Empty ? "" : $"شناسه: {user.Id.ToString()[..8]}";

    private static string GetRoleLabel(UserRole role) => role switch
    {
        UserRole.Administrator => "مدیر ارشد",
        UserRole.Manager => "مدیر",
        _ => "کاربر"
    };

    private static string GetRoleTone(UserRole role) => role switch
    {
        UserRole.Administrator => "administrator",
        UserRole.Manager => "manager",
        _ => "user"
    };

    private static string GetSectionLabel(UserSection section) => section switch
    {
        UserSection.Users => "کاربران",
        UserSection.Roads => "راه‌ها و محدوده‌ها",
        UserSection.Accidents => "حوادث",
        UserSection.Cars => "خودروها",
        UserSection.Passengers => "رانندگان و سرنشینان",
        UserSection.People => "عابر",
        UserSection.Images => "تصاویر",
        UserSection.Reports => "گزارش‌ها",
        _ => section.ToString()
    };

    private static string GetSectionIcon(UserSection section) => section switch
    {
        UserSection.Users => "bi-people",
        UserSection.Roads => "bi-map",
        UserSection.Accidents => "bi-exclamation-octagon",
        UserSection.Cars => "bi-car-front",
        UserSection.Passengers => "bi-person-vcard",
        UserSection.People => "bi-person-walking",
        UserSection.Images => "bi-images",
        UserSection.Reports => "bi-bar-chart-line",
        _ => "bi-grid"
    };

    private static string GetOperationLabel(UserAccessOperation operation) => operation switch
    {
        UserAccessOperation.View => "مشاهده",
        UserAccessOperation.Create => "ثبت",
        UserAccessOperation.Update => "ویرایش",
        UserAccessOperation.Delete => "حذف",
        UserAccessOperation.Report => "گزارش",
        _ => operation.ToString()
    };

    private static string ToPersian(int value) => value.ToString().TranslateDigits();

    private sealed class UserEditorModel
    {
        [Required(ErrorMessage = "نام کاربر الزامی است."), MaxLength(50, ErrorMessage = "نام حداکثر ۵۰ کاراکتر است.")]
        public string FirstName { get; set; } = string.Empty;

        [Required(ErrorMessage = "نام خانوادگی الزامی است."), MaxLength(50, ErrorMessage = "نام خانوادگی حداکثر ۵۰ کاراکتر است.")]
        public string LastName { get; set; } = string.Empty;

        [Required(ErrorMessage = "شماره موبایل الزامی است."), RegularExpression(@"^09\d{9}$", ErrorMessage = "شماره موبایل باید با 09 آغاز شود و ۱۱ رقم باشد.")]
        public string MobileNumber { get; set; } = string.Empty;

        public string? Password { get; set; }
        public string? ConfirmPassword { get; set; }
        public UserRole Role { get; set; } = UserRole.User;
    }

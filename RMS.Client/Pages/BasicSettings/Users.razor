@page "/users"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@inject UserApiService UserApi
@inject AuthenticationService Authentication
@inject RmsAuthenticationStateProvider AuthenticationState

<PageTitle>کاربران و دسترسی‌ها | راه‌بان کیان</PageTitle>

<PageHeader Title="کاربران و دسترسی‌ها" Eyebrow="مدیریت سامانه"
            Description="تعریف کاربران، نقش‌ها و سطح دسترسی آن‌ها بر اساس مجوزهای RMS.Api">
    <Actions>
        <button class="btn btn-light app-button" type="button" @onclick="ReloadAsync" disabled="@isLoading">
            <i class="bi bi-arrow-clockwise"></i> به‌روزرسانی
        </button>
        @if (CanCreate)
        {
            <button class="btn btn-primary app-button" type="button" @onclick="OpenCreate">
                <i class="bi bi-person-plus"></i> افزودن کاربر
            </button>
        }
    </Actions>
</PageHeader>

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="app-alert success" role="status"><i class="bi bi-check-circle"></i><span>@successMessage</span></div>
}
@if (!string.IsNullOrWhiteSpace(pageError))
{
    <div class="app-alert danger" role="alert"><i class="bi bi-exclamation-circle"></i><span>@pageError</span></div>
}

@if (!CanList)
{
    <section class="panel-card access-denied-card">
        <span><i class="bi bi-shield-lock"></i></span>
        <h2>دسترسی به فهرست کاربران محدود است</h2>
        <p>برای مشاهده این صفحه، مجوز گزارش کاربران لازم است.</p>
    </section>
}
else
{
    <section class="panel-card">
        <div class="panel-toolbar users-toolbar">
            <div class="search-field">
                <i class="bi bi-search"></i>
                <input @bind="searchTerm" @bind:event="oninput" @onkeydown="HandleSearchKeyDown" placeholder="جست‌وجو با نام، نام خانوادگی یا شماره موبایل..." />
            </div>
            <div class="toolbar-actions users-filter-actions">
                <select class="compact-select role-filter" @bind="roleFilter" aria-label="فیلتر نقش">
                    <option value="">همه نقش‌ها</option>
                    @foreach (var role in Enum.GetValues<UserRole>())
                    {
                        <option value="@role">@GetRoleLabel(role)</option>
                    }
                </select>
                <button class="btn btn-light app-button" type="button" @onclick="ApplyFiltersAsync" disabled="@isLoading">
                    <i class="bi bi-funnel"></i> اعمال فیلتر
                </button>
            </div>
        </div>

        <div class="table-responsive">
            <table class="app-table users-table">
                <thead>
                    <tr>
                        <th>کاربر</th>
                        <th>شماره موبایل</th>
                        <th>نقش</th>
                        <th>دسترسی‌ها</th>
                        <th class="actions-cell">عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (isLoading)
                    {
                        <tr><td colspan="5"><div class="table-loading"><span class="spinner-border spinner-border-sm"></span> در حال دریافت کاربران از API...</div></td></tr>
                    }
                    else if (users.Count == 0)
                    {
                        <tr><td colspan="5"><div class="empty-inline"><i class="bi bi-person-x"></i> کاربری با این معیارها پیدا نشد.</div></td></tr>
                    }
                    else
                    {
                        @foreach (var user in users)
                        {
                            <tr>
                                <td>
                                    <div class="user-table-identity">
                                        <span class="table-avatar">@GetInitials(user)</span>
                                        <div><strong>@user.FirstName @user.LastName</strong><small>@GetUserSubtitle(user)</small></div>
                                    </div>
                                </td>
                                <td><span class="ltr-value">@user.MobileNumber</span></td>
                                <td><span class="role-badge @GetRoleTone(user.Role)">@GetRoleLabel(user.Role)</span></td>
                                <td>
                                    @if (user.Role == UserRole.Administrator)
                                    {
                                        <span class="permission-summary all"><i class="bi bi-shield-check"></i> دسترسی کامل</span>
                                    }
                                    else if (user.PermissionSectionCount == 0)
                                    {
                                        <span class="permission-summary none">بدون دسترسی صریح</span>
                                    }
                                    else
                                    {
                                        <span class="permission-summary"><i class="bi bi-key"></i> @ToPersian(user.PermissionSectionCount) بخش</span>
                                    }
                                </td>
                                <td class="actions-cell">
                                    @if (CanView)
                                    {
                                        <button type="button" class="table-action" title="مشاهده و ویرایش" @onclick="() => OpenEditAsync(user.Id)">
                                            <i class="bi @(CanUpdate ? "bi-pencil-square" : "bi-eye")"></i>
                                        </button>
                                    }
                                    @if (CanDelete)
                                    {
                                        <button type="button" class="table-action danger" title="حذف کاربر"
                                                disabled="@(AuthenticationState.CurrentUser?.Id == user.Id)" @onclick="() => AskDelete(user)">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="panel-pagination">
            <span>صفحه @ToPersian(pageIndex + 1) از @ToPersian(PageCount) · مجموع @ToPersian(totalCount) کاربر</span>
            <div class="pagination-buttons">
                <button type="button" disabled="@(pageIndex == 0 || isLoading)" @onclick="PreviousPageAsync"><i class="bi bi-chevron-right"></i></button>
                <button type="button" class="active">@ToPersian(pageIndex + 1)</button>
                <button type="button" disabled="@(!hasNextPage || isLoading)" @onclick="NextPageAsync"><i class="bi bi-chevron-left"></i></button>
            </div>
        </div>
    </section>
}

<AppModal IsOpen="editorOpen" Large="true" Title="@(editingUserId.HasValue ? "ویرایش کاربر" : "افزودن کاربر")"
          Subtitle="مشخصات حساب و مجوزهای دسترسی را تعیین کنید." Icon="bi-person-gear" OnClose="CloseEditor">
    <ChildContent>
        @if (isLoadingEditor)
        {
            <div class="table-loading"><span class="spinner-border spinner-border-sm"></span> در حال دریافت اطلاعات کاربر...</div>
        }
        else
        {
            @if (!string.IsNullOrWhiteSpace(editorError))
            {
                <div class="app-alert danger" role="alert"><i class="bi bi-exclamation-circle"></i><span>@editorError</span></div>
            }
            <EditForm id="user-editor-form" Model="editor" OnValidSubmit="SaveUserAsync">
                <DataAnnotationsValidator />
                <div class="form-grid">
                    <div class="form-group">
                        <label for="first-name">نام</label>
                        <InputText id="first-name" @bind-Value="editor.FirstName" placeholder="نام کاربر" disabled="@(!CanSaveEditor || isSaving)" />
                        <ValidationMessage For="() => editor.FirstName" />
                    </div>
                    <div class="form-group">
                        <label for="last-name">نام خانوادگی</label>
                        <InputText id="last-name" @bind-Value="editor.LastName" placeholder="نام خانوادگی" disabled="@(!CanSaveEditor || isSaving)" />
                        <ValidationMessage For="() => editor.LastName" />
                    </div>
                    <div class="form-group">
                        <label for="user-mobile">شماره موبایل</label>
                        <InputText id="user-mobile" inputmode="tel" dir="ltr" @bind-Value="editor.MobileNumber" placeholder="09121234567" disabled="@(!CanSaveEditor || isSaving)" />
                        <ValidationMessage For="() => editor.MobileNumber" />
                    </div>
                    <div class="form-group">
                        <label for="user-role">نقش کاربر</label>
                        <InputSelect id="user-role" @bind-Value="editor.Role" disabled="@(!CanSaveEditor || isSaving)">
                            @foreach (var role in AvailableRoles)
                            {
                                <option value="@role">@GetRoleLabel(role)</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="form-group">
                        <label for="user-password">@(editingUserId.HasValue ? "رمز عبور جدید" : "رمز عبور")</label>
                        <InputText id="user-password" type="password" autocomplete="new-password" @bind-Value="editor.Password"
                                   placeholder="@(editingUserId.HasValue ? "برای عدم تغییر، خالی بگذارید" : "حداقل ۶ کاراکتر")" disabled="@(!CanSaveEditor || isSaving)" />
                    </div>
                    <div class="form-group">
                        <label for="confirm-password">تکرار رمز عبور</label>
                        <InputText id="confirm-password" type="password" autocomplete="new-password" @bind-Value="editor.ConfirmPassword"
                                   placeholder="تکرار رمز عبور" disabled="@(!CanSaveEditor || isSaving)" />
                    </div>
                </div>

                <div class="permission-editor">
                    <div class="permission-editor-heading">
                        <div><h3>مجوزهای دسترسی</h3><p>عملیات مجاز کاربر را برای هر بخش مشخص کنید.</p></div>
                        @if (editor.Role == UserRole.Administrator)
                        {
                            <span class="role-override-note"><i class="bi bi-shield-check"></i> مدیر ارشد مستقل از انتخاب‌های زیر دسترسی کامل دارد.</span>
                        }
                    </div>

                    @if (metadata is null)
                    {
                        <div class="metadata-warning"><i class="bi bi-exclamation-triangle"></i> metadata دسترسی‌ها از API دریافت نشده است.</div>
                    }
                    else
                    {
                        <div class="permission-table-wrap">
                            <table class="permission-table">
                                <thead>
                                    <tr>
                                        <th>بخش سامانه</th>
                                        @foreach (var operation in AvailableOperations)
                                        {
                                            <th>@GetOperationLabel(operation)</th>
                                        }
                                        <th>همه</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var section in AvailableSections)
                                    {
                                        <tr>
                                            <td><span class="section-name"><i class="bi @GetSectionIcon(section)"></i>@GetSectionLabel(section)</span></td>
                                            @foreach (var operation in AvailableOperations)
                                            {
                                                <td><input type="checkbox" checked="@HasEditorPermission(section, operation)"
                                                           disabled="@(!CanSaveEditor || isSaving)" @onchange="e => SetEditorPermission(section, operation, IsChecked(e))" /></td>
                                            }
                                            <td><input type="checkbox" checked="@HasAllEditorPermissions(section)"
                                                       disabled="@(!CanSaveEditor || isSaving)" @onchange="e => SetAllEditorPermissions(section, IsChecked(e))" /></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </EditForm>
        }
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-light app-button" @onclick="CloseEditor" disabled="@isSaving">بستن</button>
        @if (CanSaveEditor && !isLoadingEditor)
        {
            <button type="submit" form="user-editor-form" class="btn btn-primary app-button" disabled="@isSaving">
                @if (isSaving)
                {
                    <span class="spinner-border spinner-border-sm"></span><span>در حال ذخیره...</span>
                }
                else
                {
                    <i class="bi bi-check2-circle"></i><span>ذخیره اطلاعات</span>
                }
            </button>
        }
    </Footer>
</AppModal>

<AppModal IsOpen="deleteModalOpen" Title="حذف کاربر" Subtitle="این عملیات قابل بازگشت نیست." Icon="bi-trash3" OnClose="CloseDeleteModal">
    <ChildContent>
        <div class="delete-confirmation">
            <span><i class="bi bi-exclamation-triangle"></i></span>
            <div>
                <strong>آیا از حذف «@deletingUser?.FirstName @deletingUser?.LastName» مطمئن هستید؟</strong>
                <p>حساب این کاربر و تمام دسترسی‌های ثبت‌شده برای او حذف خواهد شد.</p>
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(deleteError))
        {
            <div class="app-alert danger"><i class="bi bi-exclamation-circle"></i><span>@deleteError</span></div>
        }
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-light app-button" @onclick="CloseDeleteModal" disabled="@isDeleting">انصراف</button>
        <button type="button" class="btn btn-danger app-button" @onclick="DeleteUserAsync" disabled="@isDeleting">
            @if (isDeleting)
            {
                <span class="spinner-border spinner-border-sm"></span><span>در حال حذف...</span>
            }
            else
            {
                <i class="bi bi-trash3"></i><span>حذف کاربر</span>
            }
        </button>
    </Footer>
</AppModal>



    private AccidentMapQuery BuildAccidentMapQuery()
    {
        var coordinates = mapRoads.SelectMany(road => road.Boundary.Coordinates).ToArray();
        if (coordinates.Length == 0)
        {
            return new AccidentMapQuery
            {
                StartTime = 946684800,
                EndTime = 4102444800,
                Take = 5000
            };
        }

        const double padding = 0.01;
        return new AccidentMapQuery
        {
            StartTime = 946684800,
            EndTime = 4102444800,
            MinLatitude = Math.Max(-90, coordinates.Min(point => point.Y) - padding),
            MaxLatitude = Math.Min(90, coordinates.Max(point => point.Y) + padding),
            MinLongitude = Math.Max(-180, coordinates.Min(point => point.X) - padding),
            MaxLongitude = Math.Min(180, coordinates.Max(point => point.X) + padding),
            Take = 5000
        };
    }

    private static IReadOnlyList<IReadOnlyList<MapPoint>> RoutePaths(Geometry geometry)
    {
        static IReadOnlyList<MapPoint> Convert(Coordinate[] coordinates)
        {
            if (coordinates.Length > 1 && coordinates[0].Equals2D(coordinates[^1]))
                coordinates = coordinates[..^1];
            return coordinates
                .Select(coordinate => new MapPoint(coordinate.Y, coordinate.X))
                .ToArray();
        }

        return geometry switch
        {
            LineString lineString => [Convert(lineString.Coordinates)],
            MultiLineString multiLineString => Enumerable.Range(0, multiLineString.NumGeometries)
                .Select(index => (IReadOnlyList<MapPoint>)Convert(
                    ((LineString)multiLineString.GetGeometryN(index)).Coordinates))
                .ToArray(),
            Polygon polygon => [Convert(polygon.ExteriorRing.Coordinates)],
            MultiPolygon multiPolygon => Enumerable.Range(0, multiPolygon.NumGeometries)
                .Select(index => (IReadOnlyList<MapPoint>)Convert(
                    ((Polygon)multiPolygon.GetGeometryN(index)).ExteriorRing.Coordinates))
                .ToArray(),
            _ => [Convert(geometry.Coordinates)]
        };
    }

    private static string ErrorMessage(Exception exception, string fallback) => exception switch
    {
        ApiClientException apiException => apiException.Message,
        HttpRequestException => "ارتباط با RMS.Api برقرار نشد. از اجرا بودن سرویس مطمئن شوید.",
        _ when !string.IsNullOrWhiteSpace(exception.Message) => exception.Message,
        _ => fallback
    };

    private static string GeometryLabel(string geometryType) => geometryType switch

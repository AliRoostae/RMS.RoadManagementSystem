@page "/roads"
@attribute [Authorize]
@using NetTopologySuite.Geometries
@using System.Text.Json
@inject IJSRuntime JS
@inject RoadApiService RoadApi
@inject OpenStreetMapSearchService OsmSearch
@inject OpenStreetMapRoutingService OsmRouting
@inject RmsAuthenticationStateProvider AuthenticationState
@implements IAsyncDisposable

<PageTitle>مسیرهای راه | راه‌بان کیان</PageTitle>

<PageHeader Title="مسیرهای اصلی و فرعی راه‌ها" Eyebrow="زیرساخت مکانی"
            Description="تعریف و پایش شبکه خطی راه‌ها با داده‌های زنده RMS.Api بر بستر OpenStreetMap">
    <Actions>
        @if (CanCreate)
        {
            <button class="btn btn-primary app-button" type="button" @onclick="OpenCreate">
                <i class="bi bi-plus-lg"></i> تعریف مسیر جدید
            </button>
        }
    </Actions>
</PageHeader>

@if (!CanList)
{
    <section class="panel-card access-denied-card">
        <span><i class="bi bi-shield-lock"></i></span><h2>دسترسی به راه‌ها مجاز نیست</h2>
        <p>برای دریافت محدوده‌ها از API باید مجوز گزارش راه‌ها را داشته باشید.</p>
    </section>
}
else
{
    @if (!string.IsNullOrWhiteSpace(pageError))
    {
        <div class="app-alert danger"><i class="bi bi-exclamation-circle"></i><span>@pageError</span></div>
    }
    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="app-alert success"><i class="bi bi-check2-circle"></i><span>@successMessage</span></div>
    }

    <section class="map-layout">
        <article class="panel-card map-panel">
            <div class="map-toolbar">
                <div class="map-search"><i class="bi bi-search"></i><input value="@searchTerm" @oninput="OnRoadSearchInputAsync" placeholder="جست‌وجوی راه یا محدوده..." /></div>
                <div class="map-tools"><button type="button" title="تازه‌سازی" @onclick="LoadAsync"><i class="bi bi-arrow-clockwise"></i></button></div>
            </div>
            <div id="road-map" class="road-map"></div>
            <div class="map-legend"><span><i class="legend-area"></i> مسیر ثبت‌شده</span></div>
        </article>

        <aside class="panel-card road-list-panel">
            <div class="panel-heading"><div><h2>مسیرهای ثبت‌شده</h2><p>@totalRoadCount.ToString().TranslateDigits() رکورد در سامانه</p></div></div>
            @if (isLoading)
            {
                <div class="table-loading"><span class="spinner-border spinner-border-sm"></span> در حال دریافت محدوده‌ها...</div>
            }
            else if (roads.Count == 0)
            {
                <div class="empty-inline"><i class="bi bi-inbox"></i> محدوده‌ای یافت نشد.</div>
            }
            else
            {
                <div class="road-items">
                    @foreach (var road in roads)
                    {
                        var accidentCount = road.AccidentCount;
                        <div class="road-item road-item-with-actions @(selectedRoadId == road.Id ? "selected" : null)">
                            <button type="button" class="road-item-main" @onclick="() => SelectRoadAsync(road.Id)">
                                <span class="road-item-icon @(accidentCount >= 5 ? "danger" : accidentCount > 0 ? "warning" : "primary")"><i class="bi bi-signpost-split"></i></span>
                                <span><strong>@road.Name</strong><small>شناسه: @RmsUi.ShortId(road.Id)</small><em><i class="bi bi-exclamation-diamond"></i> @accidentCount.ToString().TranslateDigits() حادثه دریافتی</em></span>
                            </button>
                            <span class="road-row-actions">
                                @if (CanUpdate)
                                {
                                    <button type="button" class="table-action" title="ویرایش" @onclick="() => OpenEditAsync(road.Id)"><i class="bi bi-pencil-square"></i></button>
                                }
                                @if (CanDelete)
                                {
                                    <button type="button" class="table-action danger" title="حذف" @onclick="() => AskDelete(road)"><i class="bi bi-trash3"></i></button>
                                }
                            </span>
                        </div>
                    }
                </div>
                <div class="panel-pagination">
                    <span>صفحه @((roadPageIndex + 1).ToString().TranslateDigits()) از @RoadPageCount.ToString().TranslateDigits()</span>
                    <div class="pagination-buttons">
                        <button type="button" title="صفحه قبل" disabled="@(roadPageIndex == 0 || isLoading)" @onclick="PreviousRoadPageAsync"><i class="bi bi-chevron-right"></i></button>
                        <button type="button" class="active">@((roadPageIndex + 1).ToString().TranslateDigits())</button>
                        <button type="button" title="صفحه بعد" disabled="@(roadPageIndex >= RoadPageCount - 1 || isLoading)" @onclick="NextRoadPageAsync"><i class="bi bi-chevron-left"></i></button>
                    </div>
                </div>
            }
        </aside>
    </section>

    <section class="stats-grid compact-stats">
        <StatCard Label="کل مسیرها" Value="@totalRoadCount.ToString().TranslateDigits()" Icon="bi-signpost-split" Tone="primary" Hint="TotalCount مستقل از صفحه‌بندی" />
        <StatCard Label="مسیرهای دارای حادثه" Value="@RoadsWithAccidents.ToString().TranslateDigits()" Icon="bi-exclamation-triangle" Tone="danger" />
        <StatCard Label="نقطه مرجع در صفحه" Value="@roads.Count(road => road.HasCentroid).ToString().TranslateDigits()" Icon="bi-geo-alt" Tone="success" />
    </section>
}

<AppModal IsOpen="editorOpen" Large="true" Title="@(editingRoadId.HasValue ? "ویرایش مسیر راه" : "تعریف مسیر راه جدید")"
          Subtitle="مسیر اصلی و شاخه‌ها در قالب MultiLineString با SRID 4326 به RMS.Api ارسال می‌شوند." Icon="bi-map" OnClose="CloseEditorAsync">
    <ChildContent>
        @if (!string.IsNullOrWhiteSpace(editorError))
        {
            <div class="app-alert danger"><i class="bi bi-exclamation-circle"></i><span>@editorError</span></div>
        }
        @if (isLoadingEditor)
        {
            <div class="table-loading"><span class="spinner-border spinner-border-sm"></span> در حال دریافت محدوده...</div>
        }
        else
        {
            <div id="road-form">
                <div class="form-group full-width"><label>نام راه یا محدوده</label><input required maxlength="150" @bind="editorName" placeholder="مثلاً آزادراه تهران–قم" /></div>
                <div class="form-group full-width osm-road-search">
                    <div class="osm-search-heading">
                        <div><label for="osm-road-query">جست‌وجوی مسیر در OpenStreetMap</label><small>نام اتوبان، آزادراه یا بزرگراه و شهر/استان را وارد کنید.</small></div>
                        <span>© OpenStreetMap contributors</span>
                    </div>
                    <div class="osm-search-form">
                        <div class="search-field osm-query-field"><i class="bi bi-search"></i><input id="osm-road-query" @bind="roadSearchText" placeholder="مثلاً آزادراه تهران قم، ایران" /></div>
                        <button type="button" class="btn btn-primary app-button" @onclick="SearchRoadAsync" disabled="@isSearchingRoad"><i class="bi bi-geo-alt"></i> جست‌وجوی مسیر</button>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(searchError))
                    {
                        <div class="app-alert danger compact-alert"><i class="bi bi-exclamation-circle"></i><span>@searchError</span></div>
                    }
                    @if (isSearchingRoad)
                    {
                        <div class="osm-search-loading"><span class="spinner-border spinner-border-sm"></span> در حال جست‌وجوی مسیر...</div>
                    }
                    else if (searchPerformed && searchResults.Count == 0 && string.IsNullOrWhiteSpace(searchError))
                    {
                        <div class="osm-search-empty"><i class="bi bi-signpost"></i> مسیر خطی مناسبی پیدا نشد؛ نام شهر یا استان را هم به عبارت اضافه کنید.</div>
                    }
                    else if (searchResults.Count > 0)
                    {
                        @if (selectedSearchResult is not null)
                        {
                            <div class="osm-selected-tools">
                                <span><i class="bi bi-check-circle"></i> مسیر اصلی و قطعات هم‌نام به ویرایشگر اضافه شدند.</span>
                            </div>
                        }
                        <div class="osm-search-results">
                            @foreach (var group in SearchResultGroups)
                            {
                                <button type="button" class="osm-search-result @(selectedOsmGroup == group.Name ? "selected" : null)" @onclick="() => SelectSearchResultAsync(group)">
                                    <span class="osm-result-icon"><i class="bi bi-signpost-split"></i></span>
                                    <span><strong>@group.Name</strong><small>@group.Description</small></span>
                                    <em>@group.Summary</em>
                                    <i class="bi bi-chevron-left"></i>
                                </button>
                            }
                        </div>
                    }
                    <small class="field-help">هر قطعه خطی به‌عنوان یک بخش از MultiLineString نگهداری می‌شود؛ می‌توانید شاخه‌ها را انتخاب، ویرایش، اضافه یا حذف کنید.</small>
                </div>
                <div class="form-group full-width road-editor-group">
                    <div class="road-editor-heading">
                        <div><label>شبکه مسیر</label><small>@roadEditorPathCount.ToString().TranslateDigits() خط و @roadEditorPointCount.ToString().TranslateDigits() نقطه</small></div>
                        @if (selectedEditorPathIndex.HasValue)
                        {
                            <span><i class="bi bi-cursor"></i> خط @(selectedEditorPathIndex.Value + 1).ToString().TranslateDigits() فعال است</span>
                        }
                    </div>
                    <div class="road-route-builder">
                        <div class="road-route-builder-actions">
                            <button type="button" class="btn btn-primary app-button" @onclick="() => BeginRouteSelectionAsync(RouteSelectionKind.Primary)" disabled="@(isRouting || routeSelectionKind.HasValue)">
                                <i class="bi bi-geo"></i> مسیر اصلی با مبدأ و مقصد
                            </button>
                            <button type="button" class="btn btn-light app-button" @onclick="() => BeginRouteSelectionAsync(RouteSelectionKind.Branch)" disabled="@(isRouting || routeSelectionKind.HasValue)">
                                <i class="bi bi-signpost-split"></i> مسیر فرعی با مبدأ و مقصد
                            </button>
                            @if (routeSelectionKind.HasValue)
                            {
                                <button type="button" class="btn btn-success app-button" @onclick="CalculateSelectedRouteAsync" disabled="@(!CanCalculateRoute)">
                                    <i class="bi bi-calculator"></i> محاسبه و رسم مسیر
                                </button>
                                <button type="button" class="btn btn-light app-button road-clear-all" @onclick="CancelRouteSelectionAsync" disabled="@isRouting">
                                    <i class="bi bi-x-lg"></i> لغو انتخاب
                                </button>
                            }
                        </div>
                        @if (routeSelectionKind.HasValue)
                        {
                            <div class="road-route-selection-note">
                                @if (isRouting)
                                {
                                    <span class="spinner-border spinner-border-sm"></span>
                                    <span>در حال محاسبه مسیر واقعی روی شبکه راه‌ها...</span>
                                }
                                else if (routeSelectionStart is null)
                                {
                                    <i class="bi bi-1-circle"></i><span>روی نقشه، نقطه شروع مسیر را انتخاب کنید.</span>
                                }
                                else if (routeSelectionEnd is null)
                                {
                                    <i class="bi bi-2-circle"></i><span>اکنون نقطه پایان مسیر را انتخاب کنید.</span>
                                }
                                else
                                {
                                    <i class="bi bi-check2-circle"></i><span>مبدأ و مقصد انتخاب شدند؛ روی «محاسبه و رسم مسیر» کلیک کنید.</span>
                                }
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(routeSelectionError))
                        {
                            <div class="app-alert danger compact-alert"><i class="bi bi-exclamation-circle"></i><span>@routeSelectionError</span></div>
                        }
                        @if (!string.IsNullOrWhiteSpace(routeSelectionSummary))
                        {
                            <div class="app-alert success compact-alert"><i class="bi bi-check2-circle"></i><span>@routeSelectionSummary</span></div>
                        }
                    </div>
                    <div id="road-editor-map" class="road-editor-map"></div>
                    <div class="road-editor-help">
                        <span><i class="bi bi-plus-circle"></i> با کلیک روی نقشه، نقطه به خط فعال اضافه می‌شود.</span>
                        <span><i class="bi bi-signpost-split"></i> برای ویرایش یک شاخه، روی همان خط کلیک کنید.</span>
                        <span><i class="bi bi-arrows-move"></i> برای ویرایش، نقطه را با ماوس یا لمس جابه‌جا کنید.</span>
                    </div>
                    <div class="road-editor-actions">
                        <button type="button" class="btn btn-light app-button" @onclick="AddPathAsync"><i class="bi bi-bezier2"></i> افزودن مسیر فرعی</button>
                        <button type="button" class="btn btn-light app-button" @onclick="DeleteSelectedPointAsync" disabled="@(!selectedEditorPointIndex.HasValue)"><i class="bi bi-x-circle"></i> حذف نقطه انتخاب‌شده</button>
                        <button type="button" class="btn btn-light app-button" @onclick="RemoveLastPointAsync" disabled="@(roadEditorPointCount == 0)"><i class="bi bi-arrow-counterclockwise"></i> حذف آخرین نقطه</button>
                        <button type="button" class="btn btn-light app-button road-clear-all" @onclick="DeleteSelectedPathAsync" disabled="@(!selectedEditorPathIndex.HasValue)"><i class="bi bi-trash3"></i> حذف خط فعال</button>
                        <button type="button" class="btn btn-light app-button road-clear-all" @onclick="ClearDrawingAsync" disabled="@(roadEditorPathCount == 0)"><i class="bi bi-eraser"></i> پاک‌کردن همه مسیرها</button>
                    </div>
                </div>
            </div>
        }
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-light app-button" @onclick="CloseEditorAsync" disabled="@isSaving">انصراف</button>
        @if (!isLoadingEditor)
        {
            <button type="button" class="btn btn-primary app-button" @onclick="SaveRoadAsync" disabled="@(isSaving || isRouting || routeSelectionKind.HasValue)">
                @if (isSaving) { <span class="spinner-border spinner-border-sm"></span><span>در حال ذخیره...</span> }
                else { <i class="bi bi-check2-circle"></i><span>ذخیره مسیر</span> }
            </button>
        }
    </Footer>
</AppModal>

<AppModal IsOpen="deleteOpen" Title="حذف مسیر" Subtitle="مسیرهای دارای حادثه توسط API حذف نمی‌شوند." Icon="bi-trash3" OnClose="CloseDelete">
    <ChildContent>
        <div class="delete-confirmation"><span><i class="bi bi-exclamation-triangle"></i></span><div><strong>آیا از حذف «@deletingRoad?.Name» مطمئن هستید؟</strong><p>این عملیات قابل بازگشت نیست.</p></div></div>
        @if (!string.IsNullOrWhiteSpace(deleteError))
        {
            <div class="app-alert danger"><i class="bi bi-exclamation-circle"></i><span>@deleteError</span></div>
        }
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-light app-button" @onclick="CloseDelete" disabled="@isDeleting">انصراف</button>
        <button type="button" class="btn btn-danger app-button" @onclick="DeleteRoadAsync" disabled="@isDeleting"><i class="bi bi-trash3"></i> حذف</button>
    </Footer>
</AppModal>



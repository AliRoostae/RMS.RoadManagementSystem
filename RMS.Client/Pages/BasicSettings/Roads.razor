    [JSInvokable]
    public Task OnRoadRoutePointSelected(double latitude, double longitude, int pointNumber)
    {
        if (!routeSelectionKind.HasValue || isRouting)
            return Task.CompletedTask;

        if (pointNumber == 1)
        {
            routeSelectionStart = new OsmGeoPoint(latitude, longitude);
            routeSelectionEnd = null;
        }
        else if (pointNumber == 2 && routeSelectionStart is not null)
        {
            routeSelectionEnd = new OsmGeoPoint(latitude, longitude);
        }

        return InvokeAsync(StateHasChanged);
    }

    private async Task CalculateSelectedRouteAsync()
    {
        if (!CanCalculateRoute ||
            routeSelectionKind is not { } selectedKind ||
            routeSelectionStart is null ||
            routeSelectionEnd is null)
            return;

        isRouting = true;
        routeSelectionError = null;
        routeSelectionSummary = null;
        try
        {
            var route = await OsmRouting.FindRouteAsync(
                routeSelectionStart,
                routeSelectionEnd);
            var points = route.Points
                .Select(point => new MapPoint(point.Latitude, point.Longitude))
                .ToArray();

            await JS.InvokeVoidAsync(
                selectedKind == RouteSelectionKind.Primary
                    ? "rmsInterop.setRoadEditorPrimaryPath"
                    : "rmsInterop.appendRoadEditorPath",
                (object)points);

            var distance = (route.DistanceMeters / 1000d).ToString("0.#").TranslateDigits();
            var duration = Math.Max(1, (int)Math.Ceiling(route.DurationSeconds / 60d))
                .ToString()
                .TranslateDigits();
            routeSelectionSummary = $"مسیر با طول تقریبی {distance} کیلومتر و زمان {duration} دقیقه به ویرایشگر اضافه شد.";
            routeSelectionKind = null;
            routeSelectionStart = null;
            routeSelectionEnd = null;
        }
        catch (Exception exception) when (exception is HttpRequestException or InvalidOperationException or JsonException or ArgumentOutOfRangeException or JSException)
        {
            routeSelectionError = exception switch
            {
                HttpRequestException => "ارتباط با سرویس مسیریابی برقرار نشد. کمی بعد دوباره تلاش کنید.",
                JSException => "مسیر محاسبه شد، اما رسم نقاط روی نقشه با خطا مواجه شد.",
                _ => exception.Message
            };
        }
        finally
        {
            isRouting = false;
        }
    }


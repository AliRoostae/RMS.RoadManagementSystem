@page "/cars"
@page "/accidents/{AccidentId:guid}/cars"
@attribute [Authorize]
@using System.Globalization
@inject AccidentApiService AccidentApi
@inject CarApiService CarApi
@inject RmsAuthenticationStateProvider AuthenticationState

<PageTitle>@PageTitleText | راه‌بان کیان</PageTitle>

<PageHeader Title="@PageTitleText" Description="@PageDescription" Eyebrow="اطلاعات حوادث">
    <Actions>
        @if (AccidentId.HasValue)
        {
            <a class="btn btn-light app-button" href="/accidents"><i class="bi bi-arrow-right"></i> بازگشت به حوادث</a>
        }
        @if (CanCreateHere)
        {
            <button class="btn btn-primary app-button" type="button" @onclick="OpenCreate">
                <i class="bi bi-plus-lg"></i> افزودن خودرو
            </button>
        }
    </Actions>
</PageHeader>

@if (!CanList)
{
    <section class="panel-card access-denied-card">
        <span><i class="bi bi-shield-lock"></i></span>
        <h2>دسترسی به این بخش مجاز نیست</h2>
        <p>برای مشاهده فهرست خودروها باید مجوز گزارش این بخش را داشته باشید.</p>
    </section>
}
else
{
    @if (!AccidentId.HasValue)
    {
        <section class="panel-card access-denied-card image-route-guide">
            <span><i class="bi bi-car-front"></i></span>
            <h2>ابتدا حادثه را انتخاب کنید</h2>
            <p>خودروها به حادثه وابسته‌اند. برای مشاهده یا ثبت خودرو، از فهرست حوادث وارد خودروهای همان حادثه شوید.</p>
            @if (CanListAccidents)
            {
                <a class="btn btn-primary app-button" href="/accidents"><i class="bi bi-exclamation-octagon"></i> مشاهده حوادث</a>
            }
        </section>
    }
    else
    {
        @if (ParentAccident is not null)
        {
            <section class="entity-context-card">
                <span class="entity-context-icon"><i class="bi bi-exclamation-octagon"></i></span>
                <div>
                    <small>حادثه انتخاب‌شده</small>
                    <strong>ACC-@RmsUi.ShortId(ParentAccident.Id)</strong>
                    <span>@RmsUi.DateTime(ParentAccident.AccidentTimeUnix) · @RmsUi.AccidentType(ParentAccident.AccidentType)</span>
                </div>
                @if (CanListPeople)
                {
                    <a class="btn btn-light app-button" href="@($"/accidents/{ParentAccident.Id}/people")"><i class="bi bi-person-walking"></i> افراد حادثه</a>
                }
            </section>
        }

        <EntityListPanel @key="AccidentId" @ref="listPanel" Columns="Columns" Rows="rows" IsLoading="isLoading"
                         TotalCount="totalCount" ErrorMessage="@pageError" SuccessMessage="@successMessage"
                         SearchPlaceholder="جست‌وجو با پلاک، مدل یا کلاس خودرو..." QueryChanged="LoadPageAsync">
            <RowActions Context="row">
                @if (CanListPassengers)
                {
                    <a class="table-action related" href="@($"/cars/{row.Id}/passengers")" title="راننده و سرنشینان خودرو"><i class="bi bi-people"></i></a>
                }
                @if (CanUpdate)
                {
                    <button type="button" class="table-action" title="ویرایش خودرو" @onclick="() => OpenEditAsync(row)"><i class="bi bi-pencil-square"></i></button>
                }
                @if (CanDelete)
                {
                    <button type="button" class="table-action danger" title="حذف خودرو" @onclick="() => AskDelete(row)"><i class="bi bi-trash3"></i></button>
                }
            </RowActions>
        </EntityListPanel>
    }
}

<AppModal IsOpen="modalOpen" Large="true" Title="@(editingRow is null ? "افزودن خودرو" : "ویرایش خودرو")"
          Subtitle="خودرو به حادثه جاری منتسب می‌شود و این انتساب قابل تغییر نیست." Icon="bi-car-front" OnClose="CloseModal">
    <ChildContent>
        @if (isLoadingEditor)
        {
            <div class="table-loading"><span class="spinner-border spinner-border-sm"></span> در حال دریافت جزئیات خودرو...</div>
        }
        else
        {
            @if (!string.IsNullOrWhiteSpace(mutationError))
            {
                <div class="app-alert danger"><i class="bi bi-exclamation-circle"></i><span>@mutationError</span></div>
            }
            <form id="car-form" @onsubmit="SaveAsync" @onsubmit:preventDefault="true">
                <div class="form-grid">
                    <div class="form-group">
                        <label for="car-plate">شماره پلاک</label>
                        <input id="car-plate" value="@GetDraft("Plate")" placeholder="ایران ۶۶ - ۱۲۳ ب ۴۵" required @oninput="ChangePlate" />
                    </div>    
                    <div class="form-group">
                    <label for="car-license-date">تاریخ صدور گواهینامه</label>
                    <DatePickerZO @ref="licenseDatePickerComponent" PopupDatePickerZO="true" Format="yyyy/MM/dd"
                                  SelectDate="@LicenseDatePicker" SelectDateChanged="OnLicenseDateChanged" />
                </div>
                    <div class="form-group">
                        <label for="car-name">نام یا مدل خودرو</label>
                        <input id="car-name" value="@GetDraft("Car")" placeholder="مثلاً پژو ۲۰۷" required @oninput="ChangeCarName" />
                    </div>
                    <div class="form-group">
                        <label for="car-class">رده خودرو</label>
                        <select id="car-class" value="@GetDraft("Class")" required @onchange="ChangeClass">
                            <option value="">انتخاب کنید</option>
                            @foreach (var value in Enum.GetValues<CarClassEnums>())
                            {
                                <option value="@Convert.ToByte(value)">@RmsUi.CarClass(value)</option>
                            }
                        </select>
                    </div> 
              
                    <div class="form-group">
                        <label for="car-year">سال تولید</label>
                        <input id="car-year" type="number" min="1300" max="2200" value="@GetDraft("Year")" placeholder="2024" required @oninput="ChangeYear" />
                    </div>
                    <div class="form-group">
                        <label for="car-color">رنگ</label>
                        <input id="car-color" value="@GetDraft("Color")" placeholder="سفید" @oninput="ChangeColor" />
                    </div>
                    <div class="form-group">
                        <label for="car-driver-phone">شماره تماس راننده</label>
                        <input id="car-driver-phone" type="tel" value="@GetDraft("DriverPhone")" placeholder="09121234567" required @oninput="ChangeDriverPhone" />
                    </div>
                    <div class="form-group">
                        <label for="car-license">شماره گواهینامه</label>
                        <input id="car-license" value="@GetDraft("License")" placeholder="شماره گواهینامه" required @oninput="ChangeLicense" />
                    </div>
                   
                    <div class="form-group">
                        <label for="car-license-validity">اعتبار گواهینامه (سال)</label>
                        <input id="car-license-validity" type="number" min="0" max="20" value="@GetDraft("LicenseValidity")" placeholder="5" required @oninput="ChangeLicenseValidity" />
                    </div>
                    <div class="form-group">
                        <label for="car-damage">درصد خسارت</label>
                        <input id="car-damage" type="number" min="1" max="100" value="@GetDraft("Damage")" placeholder="30" required @oninput="ChangeDamage" />
                    </div>
                </div>
            </form>
        }
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-light app-button" @onclick="CloseModal" disabled="@isMutating">انصراف</button>
        @if (!isLoadingEditor)
        {
            <button type="submit" form="car-form" class="btn btn-primary app-button" disabled="@isMutating">
                @if (isMutating)
                {
                    <span class="spinner-border spinner-border-sm"></span><span>در حال ذخیره...</span>
                }
                else
                {
                    <i class="bi bi-check2-circle"></i><span>ذخیره اطلاعات</span>
                }
            </button>
        }
    </Footer>
</AppModal>

<AppModal IsOpen="deleteModalOpen" Title="حذف خودرو" Subtitle="این عملیات در API انجام می‌شود و قابل بازگشت نیست."
          Icon="bi-trash3" OnClose="CloseDeleteModal">
    <ChildContent>
        <div class="delete-confirmation">
            <span><i class="bi bi-exclamation-triangle"></i></span>
            <div><strong>از حذف این خودرو مطمئن هستید؟</strong><p>در صورت داشتن راننده یا سرنشین، API ممکن است حذف را رد کند.</p></div>
        </div>
        @if (!string.IsNullOrWhiteSpace(deleteError))
        {
            <div class="app-alert danger"><i class="bi bi-exclamation-circle"></i><span>@deleteError</span></div>
        }
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-light app-button" @onclick="CloseDeleteModal" disabled="@isMutating">انصراف</button>
        <button type="button" class="btn btn-danger app-button" @onclick="ConfirmDeleteAsync" disabled="@isMutating">
            @if (isMutating)
            {
                <span class="spinner-border spinner-border-sm"></span><span>در حال حذف...</span>
            }
            else
            {
                <i class="bi bi-trash3"></i><span>حذف</span>
            }
        </button>
    </Footer>
</AppModal>

@code {
    [Parameter] public Guid? AccidentId { get; set; }

    private static readonly EntityColumn[] scopedColumns =
    [
        new("Plate", "شماره پلاک"), new("Car", "خودرو"), new("Class", "کلاس"),
        new("Year", "سال تولید"), new("Damage", "خسارت")
    ];

    private readonly List<EntityRow> rows = [];
    private readonly Dictionary<string, string> draft = new(StringComparer.OrdinalIgnoreCase);
    private EntityListPanel? listPanel;
    private AccidentResponse? ParentAccident;
    private EntityRow? editingRow;
    private EntityRow? deletingRow;
    private int totalCount;
    private bool isLoading = true;
    private bool modalOpen;
    private bool deleteModalOpen;
    private bool isLoadingEditor;
    private bool isMutating;
    private string? pageError;
    private string? mutationError;
    private string? deleteError;
    private string? successMessage;
    private DateTime licenseDatePicker = DateTime.Today;
    private DatePickerZO? licenseDatePickerComponent;

    private IReadOnlyList<EntityColumn> Columns => scopedColumns;
    private string PageTitleText => AccidentId.HasValue ? $"خودروهای حادثه ACC-{RmsUi.ShortId(AccidentId.Value)}" : "انتخاب حادثه برای خودروها";
    private string PageDescription => AccidentId.HasValue
        ? "ثبت و مدیریت خودروهای همین حادثه؛ شناسه حادثه به‌صورت خودکار اعمال می‌شود."
        : "برای مشاهده یا ثبت خودرو، ابتدا از فهرست حوادث یک حادثه را انتخاب کنید.";

    private bool CanList => AuthenticationState.HasPermission(UserSection.Cars, UserAccessOperation.Report);
    private bool CanCreate => AuthenticationState.HasPermission(UserSection.Cars, UserAccessOperation.Create);
    private bool CanCreateHere => CanCreate && AccidentId.HasValue && ParentAccident is not null;
    private bool CanUpdate => AuthenticationState.HasPermission(UserSection.Cars, UserAccessOperation.View)
        && AuthenticationState.HasPermission(UserSection.Cars, UserAccessOperation.Update);
    private bool CanDelete => AuthenticationState.HasPermission(UserSection.Cars, UserAccessOperation.Delete);
    private bool CanListAccidents => AuthenticationState.HasPermission(UserSection.Accidents, UserAccessOperation.Report);
    private bool CanListPassengers => AuthenticationState.HasPermission(UserSection.Passengers, UserAccessOperation.Report);
    private bool CanListPeople => AuthenticationState.HasPermission(UserSection.People, UserAccessOperation.Report);

    protected override async Task OnParametersSetAsync()
    {
        if (!CanList)
        {
            isLoading = false;
            return;
        }

        ParentAccident = null;
        pageError = null;
        if (AccidentId.HasValue)
        {
            try
            {
                ParentAccident = await AccidentApi.GetByIdAsync(AccidentId.Value);
            }
            catch (Exception exception) when (exception is ApiClientException or HttpRequestException)
            {
                pageError = ErrorMessage(exception, "دریافت اطلاعات حادثه با خطا مواجه شد.");
                isLoading = false;
                rows.Clear();
                totalCount = 0;
                return;
            }
        }
        else
        {
            rows.Clear();
            totalCount = 0;
            isLoading = false;
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        pageError = null;
        try
        {
            await LoadPageCoreAsync(new EntityPageRequest(0, 20, string.Empty, CancellationToken.None));
        }
        catch (Exception exception) when (exception is ApiClientException or HttpRequestException)
        {
            pageError = ErrorMessage(exception, "دریافت خودروها از API با خطا مواجه شد.");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadPageAsync(EntityPageRequest request)
    {
        isLoading = true;
        pageError = null;
        try
        {
            await LoadPageCoreAsync(request);
        }
        catch (OperationCanceledException) when (request.CancellationToken.IsCancellationRequested)
        {
        }
        catch (Exception exception) when (exception is ApiClientException or HttpRequestException)
        {
            pageError = ErrorMessage(exception, "دریافت خودروها از API با خطا مواجه شد.");
        }
        finally
        {
            if (!request.CancellationToken.IsCancellationRequested)
                isLoading = false;
        }
    }

    private async Task LoadPageCoreAsync(EntityPageRequest request)
    {
        if (!AccidentId.HasValue)
        {
            rows.Clear();
            totalCount = 0;
            return;
        }

        var result = await CarApi.GetAllAsync(new CarQueries
        {
            AccidentId = AccidentId.Value,
            Skip = request.Skip,
            Take = request.Take,
            SearchTerm = request.SearchTerm
        }, request.CancellationToken);
        rows.Clear();
        rows.AddRange(result.Items.Select(ToRow));
        totalCount = result.TotalCount;
    }

    private void OpenCreate()
    {
        if (!CanCreateHere)
            return;
        editingRow = null;
        draft.Clear();
        LicenseDatePicker = DateTime.Today;
        mutationError = null;
        isLoadingEditor = false;
        modalOpen = true;
    }

    private async Task OpenEditAsync(EntityRow row)
    {
        editingRow = row;
        draft.Clear();
        mutationError = null;
        isLoadingEditor = true;
        modalOpen = true;
        try
        {
            foreach (var item in ToDraft(await CarApi.GetByIdAsync(row.Id)))
                draft[item.Key] = item.Value;
            SyncLicenseDatePickerFromDraft();
        }
        catch (Exception exception) when (IsExpectedException(exception))
        {
            mutationError = ErrorMessage(exception, "دریافت جزئیات خودرو با خطا مواجه شد.");
        }
        finally
        {
            isLoadingEditor = false;
        }
    }

    private void CloseModal()
    {
        if (!isMutating)
            modalOpen = false;
    }

    private async Task SaveAsync()
    {
        mutationError = null;
        isMutating = true;
        try
        {
            if (editingRow is null)
            {
                if (!AccidentId.HasValue)
                    throw new InvalidOperationException("ثبت خودرو باید از صفحه حادثه انجام شود.");
                await CreateAsync(AccidentId.Value, draft);
                successMessage = "خودرو با موفقیت برای این حادثه ثبت شد.";
            }
            else
            {
                await UpdateAsync(editingRow.Id, draft);
                successMessage = "خودرو با موفقیت ویرایش شد.";
            }

            modalOpen = false;
            if (listPanel is not null)
                await listPanel.ReloadAsync();
            else
                await LoadAsync();
        }
        catch (Exception exception) when (IsExpectedException(exception))
        {
            mutationError = ErrorMessage(exception, "ذخیره اطلاعات خودرو با خطا مواجه شد.");
        }
        finally
        {
            isMutating = false;
        }
    }

    private void AskDelete(EntityRow row)
    {
        deletingRow = row;
        deleteError = null;
        deleteModalOpen = true;
    }

    private void CloseDeleteModal()
    {
        if (!isMutating)
            deleteModalOpen = false;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (deletingRow is null)
            return;
        deleteError = null;
        isMutating = true;
        try
        {
            await CarApi.DeleteAsync(deletingRow.Id);
            deleteModalOpen = false;
            successMessage = "خودرو با موفقیت حذف شد.";
            if (listPanel is not null)
                await listPanel.ReloadAsync();
            else
                await LoadAsync();
        }
        catch (Exception exception) when (IsExpectedException(exception))
        {
            deleteError = ErrorMessage(exception, "حذف خودرو با خطا مواجه شد.");
        }
        finally
        {
            isMutating = false;
        }
    }

    private Task CreateAsync(Guid accidentId, IReadOnlyDictionary<string, string> values) => CarApi.CreateAsync(new CreateCarCommand
    {
        FkAccident = accidentId,
        PlateNumber = FormValues.Required(values, "Plate", "شماره پلاک"),
        CarName = FormValues.Required(values, "Car", "نام خودرو"),
        CarClass = FormValues.Enum<CarClassEnums>(values, "Class", "رده خودرو"),
        ProductionYear = FormValues.Int(values, "Year", "سال تولید"),
        Color = FormValues.Optional(values, "Color"),
        DriverPhone = FormValues.Required(values, "DriverPhone", "شماره تماس راننده"),
        DriverLicNumber = FormValues.Required(values, "License", "شماره گواهینامه"),
        DateLic = FormValues.Date(values, "LicenseDate", "تاریخ صدور گواهینامه"),
        DateLicValidity = FormValues.Byte(values, "LicenseValidity", "اعتبار گواهینامه"),
        DamagePercentage = FormValues.Byte(values, "Damage", "درصد خسارت")
    });

    private Task UpdateAsync(Guid id, IReadOnlyDictionary<string, string> values) => CarApi.UpdateAsync(id, new UpdateCarCommand
    {
        Id = id,
        PlateNumber = FormValues.Required(values, "Plate", "شماره پلاک"),
        CarName = FormValues.Required(values, "Car", "نام خودرو"),
        CarClass = FormValues.Enum<CarClassEnums>(values, "Class", "رده خودرو"),
        ProductionYear = FormValues.Int(values, "Year", "سال تولید"),
        Color = FormValues.Optional(values, "Color"),
        DriverPhone = FormValues.Required(values, "DriverPhone", "شماره تماس راننده"),
        DriverLicNumber = FormValues.Required(values, "License", "شماره گواهینامه"),
        DateLic = FormValues.Date(values, "LicenseDate", "تاریخ صدور گواهینامه"),
        DateLicValidity = FormValues.Byte(values, "LicenseValidity", "اعتبار گواهینامه"),
        DamagePercentage = FormValues.Byte(values, "Damage", "درصد خسارت")
    });

    private static EntityRow ToRow(CarListItemResponse car) => new()
    {
        Id = car.Id,
        Status = car.DamagePercentage >= 70 ? "خسارت سنگین" : car.DamagePercentage >= 30 ? "نیازمند بررسی" : "ثبت‌شده",
        StatusTone = RmsUi.InjuryTone(car.DamagePercentage),
        Values = new()
        {
            ["Plate"] = car.PlateNumber,
            ["Car"] = car.CarName,
            ["Class"] = RmsUi.CarClass(car.CarClass),
            ["Year"] = car.ProductionYear.ToString().TranslateDigits(),
            ["Damage"] = $"{car.DamagePercentage.ToString().TranslateDigits()}٪"
        }
    };

    private static IReadOnlyDictionary<string, string> ToDraft(CarResponse car) => new Dictionary<string, string>
    {
        ["Plate"] = car.PlateNumber,
        ["Car"] = car.CarName,
        ["Class"] = Convert.ToByte(car.CarClass).ToString(),
        ["Year"] = car.ProductionYear.ToString(),
        ["Color"] = car.Color,
        ["DriverPhone"] = car.DriverPhone,
        ["License"] = car.DriverLicNumber,
        ["LicenseDate"] = car.DateLic.ToString("yyyy-MM-dd"),
        ["LicenseValidity"] = car.DateLicValidity.ToString(),
        ["Damage"] = car.DamagePercentage.ToString()
    };

    private string GetDraft(string key) => draft.GetValueOrDefault(key, string.Empty);
    private void SetDraft(string key, object? value) => draft[key] = value?.ToString() ?? string.Empty;
    private void ChangePlate(ChangeEventArgs eventArgs) => SetDraft("Plate", eventArgs.Value);
    private void ChangeCarName(ChangeEventArgs eventArgs) => SetDraft("Car", eventArgs.Value);
    private void ChangeClass(ChangeEventArgs eventArgs) => SetDraft("Class", eventArgs.Value);
    private void ChangeYear(ChangeEventArgs eventArgs) => SetDraft("Year", eventArgs.Value);
    private void ChangeColor(ChangeEventArgs eventArgs) => SetDraft("Color", eventArgs.Value);
    private void ChangeDriverPhone(ChangeEventArgs eventArgs) => SetDraft("DriverPhone", eventArgs.Value);
    private void ChangeLicense(ChangeEventArgs eventArgs) => SetDraft("License", eventArgs.Value);
    private DateTime LicenseDatePicker
    {
        get => licenseDatePicker;
        set
        {
            licenseDatePicker = value;
            draft["LicenseDate"] = DateOnly.FromDateTime(value).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        }
    }

    private void SyncLicenseDatePickerFromDraft()
    {
        if (DateOnly.TryParseExact(GetDraft("LicenseDate"), "yyyy-MM-dd", CultureInfo.InvariantCulture,
            DateTimeStyles.None, out var value))
        {
            licenseDatePicker = value.ToDateTime(TimeOnly.MinValue);
        }
    }

    private void OnLicenseDateChanged()
    {
        if (licenseDatePickerComponent is not null)
            LicenseDatePicker = licenseDatePickerComponent.SelectDate ?? DateTime.Today;
    }
    private void ChangeLicenseValidity(ChangeEventArgs eventArgs) => SetDraft("LicenseValidity", eventArgs.Value);
    private void ChangeDamage(ChangeEventArgs eventArgs) => SetDraft("Damage", eventArgs.Value);

    private static bool IsExpectedException(Exception exception) =>
        exception is ApiClientException or HttpRequestException or FormatException or InvalidOperationException or ArgumentException;

    private static string ErrorMessage(Exception exception, string fallback) => exception switch
    {
        ApiClientException apiException => apiException.Message,
        HttpRequestException => "ارتباط با RMS.Api برقرار نشد. از اجرا بودن سرویس مطمئن شوید.",
        _ when !string.IsNullOrWhiteSpace(exception.Message) => exception.Message,
        _ => fallback
    };
}

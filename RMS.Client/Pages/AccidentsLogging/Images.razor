@page "/images"
@page "/accidents/{AccidentId:guid}/images"
@attribute [Authorize]
@inject AccidentApiService AccidentApi
@inject ImageApiService ImageApi
@inject LookupApiService LookupApi
@inject NavigationManager Navigation
@inject RmsAuthenticationStateProvider AuthenticationState

<PageTitle>@PageTitleText | راه‌بان کیان</PageTitle>

<PageHeader Title="@PageTitleText" Eyebrow="مستندات تصویری" Description="@PageDescription">
    <Actions>
        @if (AccidentId.HasValue)
        {
            <a class="btn btn-light app-button" href="/accidents"><i class="bi bi-arrow-right"></i> بازگشت به حوادث</a>
        }
        @if (CanDelete && AccidentId.HasValue && images.Count > 0)
        {
            <button class="btn btn-light app-button text-danger" @onclick="AskDeleteAll"><i class="bi bi-trash3"></i> حذف همه تصاویر</button>
        }
        @if (CanCreateHere)
        {
            <button class="btn btn-primary app-button" @onclick="OpenUpload"><i class="bi bi-cloud-arrow-up"></i> بارگذاری تصویر</button>
        }
    </Actions>
</PageHeader>

@if (!CanList)
{
    <section class="panel-card access-denied-card">
        <span><i class="bi bi-shield-lock"></i></span>
        <h2>دسترسی به تصاویر مجاز نیست</h2>
        <p>برای دریافت تصاویر از API باید مجوز گزارش تصاویر را داشته باشید.</p>
    </section>
}
else if (!AccidentId.HasValue)
{
    <section class="panel-card access-denied-card image-route-guide">
        <span><i class="bi bi-images"></i></span>
        <h2>ابتدا حادثه را انتخاب کنید</h2>
        <p>تصاویر به حادثه وابسته‌اند. برای مشاهده یا ثبت تصویر، از فهرست حوادث وارد تصاویر همان حادثه شوید.</p>
        @if (CanListAccidents)
        {
            <div class="parent-lookup-guide">
                <label>انتخاب حادثه</label>
                <AsyncLookup Value="" ValueChanged="SelectAccidentAsync"
                             SearchAsync="SearchAccidentsAsync" Placeholder="حادثه را جست‌وجو کنید..." />
            </div>
            <a class="btn btn-primary app-button" href="/accidents"><i class="bi bi-exclamation-octagon"></i> مشاهده حوادث</a>
        }
    </section>
}
else
{
    @if (parentAccident is not null)
    {
        <section class="entity-context-card">
            <span class="entity-context-icon"><i class="bi bi-exclamation-octagon"></i></span>
            <div>
                <small>حادثه انتخاب‌شده</small>
                <strong>ACC-@RmsUi.ShortId(parentAccident.Id)</strong>
                <span>@RmsUi.DateTime(parentAccident.AccidentTimeUnix) · @RmsUi.AccidentType(parentAccident.AccidentType)</span>
            </div>
            @if (CanListCars)
            {
                <a class="btn btn-light app-button" href="@($"/accidents/{parentAccident.Id}/cars")"><i class="bi bi-car-front"></i> خودروهای حادثه</a>
            }
        </section>
    }

    @if (!string.IsNullOrWhiteSpace(pageError))
    {
        <div class="app-alert danger"><i class="bi bi-exclamation-circle"></i><span>@pageError</span></div>
    }
    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="app-alert success"><i class="bi bi-check2-circle"></i><span>@successMessage</span></div>
    }

    <section class="panel-card">
        <div class="panel-toolbar image-toolbar">
            <div class="toolbar-actions">
                <button class="btn btn-light app-button" type="button" @onclick="LoadImagesAsync" disabled="@isLoading">
                    <i class="bi bi-arrow-clockwise"></i> تازه‌سازی
                </button>
            </div>
        </div>

        @if (isLoading)
        {
            <div class="table-loading"><span class="spinner-border spinner-border-sm"></span> در حال دریافت تصاویر از API...</div>
        }
        else if (images.Count == 0)
        {
            <div class="empty-inline image-empty"><i class="bi bi-images"></i> برای این حادثه تصویری ثبت نشده است.</div>
        }
        else
        {
            <div class="gallery-grid">
                @foreach (var item in images)
                {
                    <article class="gallery-card">
                        <button type="button" class="gallery-image-button" @onclick="() => OpenViewer(item)" aria-label="نمایش بزرگ تصویر">
                            <div class="gallery-image-wrap">
                                <img src="@ImageApi.ResolveUrl(item.ImageUrls)" alt="تصویر حادثه @RmsUi.ShortId(item.FkAccident)" loading="lazy" />
                                <span class="gallery-zoom-hint"><i class="bi bi-arrows-fullscreen"></i></span>
                            </div>
                        </button>
                        <div class="gallery-card-body">
                            <div><strong>IMG-@RmsUi.ShortId(item.Id)</strong><span>تصویر ثبت‌شده برای حادثه جاری</span></div>
                            @if (CanDelete)
                            {
                                <button type="button" class="table-action danger" title="حذف تصویر" @onclick="() => AskDelete(item)"><i class="bi bi-trash3"></i></button>
                            }
                        </div>
                        <div class="gallery-meta"><span><i class="bi bi-link-45deg"></i> @item.ImageUrls</span><span>WebP</span></div>
                    </article>
                }
            </div>
        }
    </section>
}

<AppModal IsOpen="uploadOpen" Title="بارگذاری تصویر حادثه"
          Subtitle="تصویر مستقیماً برای حادثه جاری در RMS.Api ذخیره می‌شود." Icon="bi-image" OnClose="CloseUpload">
    <ChildContent>
        @if (!string.IsNullOrWhiteSpace(uploadError))
        {
            <div class="app-alert danger"><i class="bi bi-exclamation-circle"></i><span>@uploadError</span></div>
        }
        <form id="image-form" @onsubmit="UploadAsync" @onsubmit:preventDefault="true">
            <label class="upload-zone">
                <i class="bi bi-cloud-arrow-up"></i><strong>@(selectedFile is null ? "تصویر را انتخاب کنید" : selectedFile.Name)</strong>
                <span>JPG / PNG / WebP تا ۱٫۴ مگابایت</span>
                <InputFile OnChange="SelectFile" accept="image/jpeg,image/png,image/webp" />
            </label>
        </form>
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-light app-button" @onclick="CloseUpload" disabled="@isUploading">انصراف</button>
        <button type="submit" form="image-form" class="btn btn-primary app-button" disabled="@isUploading">
            @if (isUploading)
            {
                <span class="spinner-border spinner-border-sm"></span><span>در حال ارسال...</span>
            }
            else
            {
                <i class="bi bi-cloud-arrow-up"></i><span>بارگذاری تصویر</span>
            }
        </button>
    </Footer>
</AppModal>

<AppModal IsOpen="deleteOpen" Title="حذف تصویر" Subtitle="این عملیات قابل بازگشت نیست." Icon="bi-trash3" OnClose="CloseDelete">
    <ChildContent>
        <div class="delete-confirmation">
            <span><i class="bi bi-exclamation-triangle"></i></span>
            <div><strong>@(deleteAll ? "همه تصاویر این حادثه حذف شوند؟" : "تصویر انتخاب‌شده حذف شود؟")</strong><p>حذف فایل و رکورد توسط RMS.Api انجام خواهد شد.</p></div>
        </div>
        @if (!string.IsNullOrWhiteSpace(deleteError))
        {
            <div class="app-alert danger"><i class="bi bi-exclamation-circle"></i><span>@deleteError</span></div>
        }
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-light app-button" @onclick="CloseDelete" disabled="@isDeleting">انصراف</button>
        <button type="button" class="btn btn-danger app-button" @onclick="DeleteAsync" disabled="@isDeleting">
            @if (isDeleting)
            {
                <span class="spinner-border spinner-border-sm"></span><span>در حال حذف...</span>
            }
            else
            {
                <i class="bi bi-trash3"></i><span>حذف</span>
            }
        </button>
    </Footer>
</AppModal>

@if (viewerImage is not null)
{
    <div class="image-viewer-backdrop" role="dialog" aria-modal="true" aria-label="نمایش بزرگ تصویر" @onclick="CloseViewer">
        <div class="image-viewer" @onclick:stopPropagation="true">
            <div class="image-viewer-toolbar">
                <span>تصویر @(viewerIndex + 1) از @images.Count</span>
                <button type="button" class="image-viewer-close" aria-label="بستن" @onclick="CloseViewer">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="image-viewer-stage">
                @if (images.Count > 1)
                {
                    <button type="button" class="image-viewer-nav previous" aria-label="تصویر قبلی" @onclick="PreviousViewerImage">
                        <i class="bi bi-chevron-right"></i>
                    </button>
                }
                <img src="@ImageApi.ResolveUrl(viewerImage.ImageUrls)" alt="تصویر بزرگ حادثه" />
                @if (images.Count > 1)
                {
                    <button type="button" class="image-viewer-nav next" aria-label="تصویر بعدی" @onclick="NextViewerImage">
                        <i class="bi bi-chevron-left"></i>
                    </button>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid? AccidentId { get; set; }

    private const long MaxUploadBytes = 1_400_000;
    private readonly List<ImageResponse> images = [];
    private AccidentResponse? parentAccident;
    private bool isLoading = true;
    private string? pageError;
    private string? successMessage;

    private bool uploadOpen;
    private IBrowserFile? selectedFile;
    private bool isUploading;
    private string? uploadError;

    private bool deleteOpen;
    private bool deleteAll;
    private ImageResponse? deletingImage;
    private bool isDeleting;
    private string? deleteError;

    private ImageResponse? viewerImage;
    private int viewerIndex;

    private string PageTitleText => AccidentId.HasValue
        ? $"تصاویر حادثه ACC-{RmsUi.ShortId(AccidentId.Value)}"
        : "تصاویر حوادث";
    private string PageDescription => AccidentId.HasValue
        ? "مشاهده و ثبت تصاویر همین حادثه؛ شناسه حادثه به‌صورت خودکار اعمال می‌شود."
        : "تصاویر هر حادثه از صفحه اختصاصی همان حادثه مدیریت می‌شوند.";

    private bool CanList => AuthenticationState.HasPermission(UserSection.Images, UserAccessOperation.Report);
    private bool CanCreate => AuthenticationState.HasPermission(UserSection.Images, UserAccessOperation.Create);
    private bool CanCreateHere => CanCreate && AccidentId.HasValue && parentAccident is not null;
    private bool CanDelete => AuthenticationState.HasPermission(UserSection.Images, UserAccessOperation.Delete);
    private bool CanListAccidents => AuthenticationState.HasPermission(UserSection.Accidents, UserAccessOperation.Report);
    private bool CanListCars => AuthenticationState.HasPermission(UserSection.Cars, UserAccessOperation.Report);

    private Task SelectAccidentAsync(string value)
    {
        if (Guid.TryParse(value, out var accidentId))
            Navigation.NavigateTo($"/accidents/{accidentId}/images");
        return Task.CompletedTask;
    }

    private async Task<IReadOnlyList<LookupOption>> SearchAccidentsAsync(string term, CancellationToken token) =>
        (await LookupApi.GetAccidentsAsync(new AccidentLookupQuery { SearchTerm = term, Take = 20 }, token))
            .Select(accident => new LookupOption(accident.Id.ToString(), $"{accident.RoadName} · {RmsUi.DateTime(accident.AccidentTimeUnix)}"))
            .ToArray();

    protected override async Task OnParametersSetAsync()
    {
        images.Clear();
        parentAccident = null;
        pageError = null;

        if (!CanList || !AccidentId.HasValue)
        {
            isLoading = false;
            return;
        }

        isLoading = true;
        try
        {
            parentAccident = await AccidentApi.GetByIdAsync(AccidentId.Value);
            await LoadImagesCoreAsync();
        }
        catch (Exception exception) when (exception is ApiClientException or HttpRequestException)
        {
            pageError = ErrorMessage(exception, "دریافت اطلاعات حادثه و تصاویر آن با خطا مواجه شد.");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadImagesAsync()
    {
        images.Clear();
        if (!AccidentId.HasValue)
        {
            isLoading = false;
            return;
        }

        isLoading = true;
        pageError = null;
        try
        {
            await LoadImagesCoreAsync();
        }
        catch (Exception exception) when (exception is ApiClientException or HttpRequestException)
        {
            pageError = ErrorMessage(exception, "دریافت تصاویر حادثه با خطا مواجه شد.");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadImagesCoreAsync()
    {
        if (!AccidentId.HasValue)
            return;
        images.AddRange(await ImageApi.GetAllAsync(AccidentId.Value));
    }

    private void OpenViewer(ImageResponse image)
    {
        viewerIndex = images.FindIndex(item => item.Id == image.Id);
        viewerIndex = viewerIndex < 0 ? 0 : viewerIndex;
        viewerImage = images.Count == 0 ? null : images[viewerIndex];
    }

    private void CloseViewer() => viewerImage = null;

    private void PreviousViewerImage()
    {
        if (images.Count == 0)
            return;

        viewerIndex = (viewerIndex - 1 + images.Count) % images.Count;
        viewerImage = images[viewerIndex];
    }

    private void NextViewerImage()
    {
        if (images.Count == 0)
            return;

        viewerIndex = (viewerIndex + 1) % images.Count;
        viewerImage = images[viewerIndex];
    }

    private void OpenUpload()
    {
        if (!CanCreateHere)
            return;
        selectedFile = null;
        uploadError = null;
        uploadOpen = true;
    }

    private void CloseUpload()
    {
        if (!isUploading)
            uploadOpen = false;
    }

    private void SelectFile(InputFileChangeEventArgs args)
    {
        selectedFile = args.File;
        uploadError = selectedFile.Size > MaxUploadBytes ? "حجم تصویر نباید بیشتر از ۱٫۴ مگابایت باشد." : null;
    }

    private async Task UploadAsync()
    {
        uploadError = null;
        if (!AccidentId.HasValue)
        {
            uploadError = "بارگذاری تصویر باید از صفحه حادثه انجام شود.";
            return;
        }
        if (selectedFile is null)
        {
            uploadError = "یک تصویر انتخاب کنید.";
            return;
        }
        if (selectedFile.Size > MaxUploadBytes)
        {
            uploadError = "حجم تصویر نباید بیشتر از ۱٫۴ مگابایت باشد.";
            return;
        }

        isUploading = true;
        try
        {
            await using var stream = selectedFile.OpenReadStream(MaxUploadBytes);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);
            var base64 = $"data:{selectedFile.ContentType};base64,{Convert.ToBase64String(memory.ToArray())}";
            await ImageApi.CreateAsync(new CreateAccidentImageCommand
            {
                AccidentId = AccidentId.Value,
                Base64Image = base64
            });
            uploadOpen = false;
            successMessage = "تصویر با موفقیت برای این حادثه بارگذاری شد.";
            await LoadImagesAsync();
        }
        catch (Exception exception) when (exception is ApiClientException or HttpRequestException or IOException)
        {
            uploadError = ErrorMessage(exception, "بارگذاری تصویر با خطا مواجه شد.");
        }
        finally
        {
            isUploading = false;
        }
    }

    private void AskDelete(ImageResponse image)
    {
        deletingImage = image;
        deleteAll = false;
        deleteError = null;
        deleteOpen = true;
    }

    private void AskDeleteAll()
    {
        deletingImage = null;
        deleteAll = true;
        deleteError = null;
        deleteOpen = true;
    }

    private void CloseDelete()
    {
        if (!isDeleting)
            deleteOpen = false;
    }

    private async Task DeleteAsync()
    {
        isDeleting = true;
        deleteError = null;
        try
        {
            if (deleteAll && AccidentId.HasValue)
                await ImageApi.DeleteAllAsync(AccidentId.Value);
            else if (deletingImage is not null)
                await ImageApi.DeleteAsync(deletingImage.Id);
            else
                return;

            deleteOpen = false;
            successMessage = deleteAll ? "همه تصاویر حادثه حذف شدند." : "تصویر با موفقیت حذف شد.";
            await LoadImagesAsync();
        }
        catch (Exception exception) when (exception is ApiClientException or HttpRequestException)
        {
            deleteError = ErrorMessage(exception, "حذف تصویر با خطا مواجه شد.");
        }
        finally
        {
            isDeleting = false;
        }
    }

    private static string ErrorMessage(Exception exception, string fallback) => exception switch
    {
        ApiClientException apiException => apiException.Message,
        HttpRequestException => "ارتباط با RMS.Api برقرار نشد. از اجرا بودن سرویس مطمئن شوید.",
        IOException => "خواندن فایل تصویر با خطا مواجه شد.",
        _ => fallback
    };
}

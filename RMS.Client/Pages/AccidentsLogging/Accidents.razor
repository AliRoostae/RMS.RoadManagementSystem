    private static LookupOption[] EnumOptions<TEnum>(Func<TEnum, string> label)
        where TEnum : struct, Enum => Enum.GetValues<TEnum>()
            .Select(value => new LookupOption(Convert.ToByte(value).ToString(), label(value)))
            .ToArray();


    private void SyncAccidentDatePickerFromDraft()
    {
        if (DateTime.TryParseExact(GetDraft("Date"), "yyyy-MM-ddTHH:mm", CultureInfo.InvariantCulture,
            DateTimeStyles.None, out var value))
        {
            accidentDatePicker = value;
        }
    }


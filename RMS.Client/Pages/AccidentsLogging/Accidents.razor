@page "/accidents"
@attribute [Authorize]
@using System.Globalization
@using NetTopologySuite.Geometries
@inject IJSRuntime JS
@inject AccidentApiService AccidentApi
@inject LookupApiService LookupApi
@inject RoadApiService RoadApi
@inject RmsAuthenticationStateProvider AuthenticationState
@implements IAsyncDisposable

<PageTitle>مدیریت حوادث | راه‌بان کیان</PageTitle>

<PageHeader Title="مدیریت حوادث" Description="ثبت، جست‌وجو و بررسی حوادث جاده‌ای با دسترسی مستقیم به اطلاعات وابسته" Eyebrow="عملیات و پایش">
    <Actions>
        @if (CanCreate)
        {
            <button class="btn btn-primary app-button" type="button" @onclick="OpenCreateAsync">
                <i class="bi bi-plus-lg"></i> افزودن حادثه
            </button>
        }
    </Actions>
</PageHeader>

@if (!CanList)
{
    <section class="panel-card access-denied-card">
        <span><i class="bi bi-shield-lock"></i></span>
        <h2>دسترسی به این بخش مجاز نیست</h2>
        <p>برای مشاهده فهرست حوادث باید مجوز گزارش این بخش را داشته باشید.</p>
    </section>
}
else
{
    <section class="panel-card parent-lookup-guide">
        <label>انتخاب راه</label>
        <AsyncLookup Value="@selectedRoad" ValueChanged="SelectFilterRoadAsync"
                     SearchAsync="SearchRoadsAsync" Placeholder="ابتدا نام راه را جست‌وجو کنید..." Required="true" />
        <label>ماه مورد نظر</label>
        <YearMonthZO @ref="filterMonthPickerComponent" SelectDate="@filterMonth" SelectDateChanged="OnFilterMonthChanged" />
       
        <small class="field-help">لیست حوادث فقط برای راه و ماه انتخاب‌شده دریافت می‌شود.</small>
    </section>

    @if (!filterRoadId.HasValue)
    {
        <section class="panel-card empty-inline"><i class="bi bi-signpost-2"></i> برای دریافت حوادث ابتدا یک راه انتخاب کنید.</section>
    }
    else
    {
    <EntityListPanel @ref="listPanel" Columns="columns" Rows="rows" IsLoading="isLoading"
                     TotalCount="totalCount" ErrorMessage="@pageError" SuccessMessage="@successMessage"
                     SearchPlaceholder="جست‌وجو با نام راه یا شناسه کامل حادثه..." QueryChanged="LoadPageAsync">
        <RowActions Context="row">
            @if (CanListCars)
            {
                <a class="table-action related" href="@($"/accidents/{row.Id}/cars")" title="خودروهای حادثه"><i class="bi bi-car-front"></i></a>
            }
            @if (CanListPeople)
            {
                <a class="table-action related" href="@($"/accidents/{row.Id}/people")" title="عابران و افراد حادثه"><i class="bi bi-person-walking"></i></a>
            }
            @if (CanListImages)
            {
                <a class="table-action related" href="@($"/accidents/{row.Id}/images")" title="تصاویر حادثه"><i class="bi bi-images"></i></a>
            }
            @if (CanUpdate)
            {
                <button type="button" class="table-action" title="ویرایش حادثه" @onclick="() => OpenEditAsync(row)"><i class="bi bi-pencil-square"></i></button>
            }
            @if (CanDelete)
            {
                <button type="button" class="table-action danger" title="حذف حادثه" @onclick="() => AskDelete(row)"><i class="bi bi-trash3"></i></button>
            }
        </RowActions>
    </EntityListPanel>
    }
}

<AppModal IsOpen="modalOpen" Large="true" Title="@(editingRow is null ? "افزودن حادثه" : "ویرایش حادثه")"
          Subtitle="اطلاعات حادثه مستقیماً در RMS.Api ذخیره می‌شود." Icon="bi-exclamation-octagon" OnClose="CloseModalAsync">
    <ChildContent>
        @if (isLoadingEditor)
        {
            <div class="table-loading"><span class="spinner-border spinner-border-sm"></span> در حال دریافت جزئیات حادثه...</div>
        }
        else
        {
            @if (!string.IsNullOrWhiteSpace(mutationError))
            {
                <div class="app-alert danger"><i class="bi bi-exclamation-circle"></i><span>@mutationError</span></div>
            }
            <form id="accident-form" @onsubmit="SaveAsync" @onsubmit:preventDefault="true">
                <div class="form-grid">
                    <div class="form-group">
                        <label>راه یا محدوده</label>
                        <AsyncLookup Value="@GetDraft("Road")" ValueChanged="ChangeRoadAsync"
                                     SearchAsync="SearchRoadsAsync" Placeholder="نام راه را تایپ کنید..." Required="true" />
                        <small class="field-help">برای مشاهده گزینه‌ها نام راه را جست‌وجو کنید.</small>
                    </div>
                    <div class="form-group">
                        <label for="accident-date">زمان وقوع حادثه</label>
                        <DatePickerZO @ref="accidentDatePickerComponent" PopupDatePickerZO="true" 
                                      SelectDate="@AccidentDatePicker" SelectDateChanged="OnAccidentDateChanged" />
                    </div>
                    <div class="form-group">
                        <label for="accident-weather">وضعیت آب‌وهوا</label>
                        <select id="accident-weather" value="@GetDraft("Weather")" required @onchange="ChangeWeather">
                            <option value="">انتخاب کنید</option>
                            @foreach (var option in EnumOptions<WeatherConditionEnums>(RmsUi.Weather))
                            {
                                <option value="@option.Value">@option.Label</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="accident-road-condition">وضعیت سطح راه</label>
                        <select id="accident-road-condition" value="@GetDraft("RoadCondition")" required @onchange="ChangeRoadCondition">
                            <option value="">انتخاب کنید</option>
                            @foreach (var option in EnumOptions<RoadConditionEnums>(RmsUi.RoadCondition))
                            {
                                <option value="@option.Value">@option.Label</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="accident-lighting">وضعیت روشنایی</label>
                        <select id="accident-lighting" value="@GetDraft("Lighting")" required @onchange="ChangeLighting">
                            <option value="">انتخاب کنید</option>
                            @foreach (var option in EnumOptions<LightingConditionEnums>(RmsUi.Lighting))
                            {
                                <option value="@option.Value">@option.Label</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="accident-sign">وضعیت علائم ترافیکی</label>
                        <select id="accident-sign" value="@GetDraft("Sign")" required @onchange="ChangeSign">
                            <option value="">انتخاب کنید</option>
                            @foreach (var option in EnumOptions<TrafficSignConditionEnums>(RmsUi.TrafficSign))
                            {
                                <option value="@option.Value">@option.Label</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="accident-cause">علت حادثه</label>
                        <select id="accident-cause" value="@GetDraft("Cause")" required @onchange="ChangeCause">
                            <option value="">انتخاب کنید</option>
                            @foreach (var option in EnumOptions<AccidentCauseEnums>(RmsUi.AccidentCause))
                            {
                                <option value="@option.Value">@option.Label</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="accident-type">نوع برخورد</label>
                        <select id="accident-type" value="@GetDraft("Type")" required @onchange="ChangeType">
                            <option value="">انتخاب کنید</option>
                            @foreach (var option in EnumOptions<AccidentTypeEnums>(RmsUi.AccidentType))
                            {
                                <option value="@option.Value">@option.Label</option>
                            }
                        </select>
                    </div>
                </div>

        <section class="accident-location-editor">
            <div class="accident-location-heading">
                <div>
                    <span class="accident-location-icon"><i class="bi bi-geo-alt"></i></span>
                    <div>
                        <strong>موقعیت حادثه روی نقشه</strong>
                        <small>نقطه را روی مسیر انتخاب کنید یا نشانگر را جابه‌جا کنید.</small>
                    </div>
                </div>
                <div class="accident-location-actions">
                    <button type="button" class="btn btn-light app-button" @onclick="UseCurrentLocationAsync"
                            disabled="@(selectedAccidentRoadId is null || isLocating)">
                        @if (isLocating)
                        {
                            <span class="spinner-border spinner-border-sm"></span><span>دریافت موقعیت...</span>
                        }
                        else
                        {
                            <i class="bi bi-crosshair"></i><span>موقعیت فعلی (GPS)</span>
                        }
                    </button>
                    <button type="button" class="btn btn-light app-button accident-location-clear"
                            @onclick="ClearAccidentLocationAsync" disabled="@(selectedLatitude is null)">
                        <i class="bi bi-x-circle"></i><span>پاک کردن نقطه</span>
                    </button>
                </div>
            </div>

            @if (selectedLatitude.HasValue && selectedLongitude.HasValue)
            {
                <div class="accident-coordinate-summary">
                    <span><i class="bi bi-check2-circle"></i> موقعیت انتخاب شد</span>
                    <code dir="ltr">@CoordinateLabel</code>
                    @if (gpsAccuracy.HasValue)
                    {
                        <small>دقت تقریبی GPS: @gpsAccuracy.Value.ToString("0", CultureInfo.InvariantCulture).TranslateDigits() متر</small>
                    }
                </div>
            }
            else if (selectedAccidentRoadId is null)
            {
                <div class="accident-location-note"><i class="bi bi-info-circle"></i> ابتدا راه مرتبط با حادثه را انتخاب کنید.</div>
            }
            else
            {
                <div class="accident-location-note"><i class="bi bi-cursor"></i> روی محل حادثه در نقشه کلیک کنید.</div>
            }

            @if (!string.IsNullOrWhiteSpace(locationError))
            {
                <div class="app-alert danger accident-location-error"><i class="bi bi-exclamation-circle"></i><span>@locationError</span></div>
            }

            <div id="accident-location-map" class="accident-location-map"></div>
            <div class="accident-location-help">
                <span><i class="bi bi-mouse"></i> کلیک روی نقشه: تعیین نقطه</span>
                <span><i class="bi bi-arrows-move"></i> جابه‌جایی نشانگر: اصلاح دقیق موقعیت</span>
                <span><i class="bi bi-shield-check"></i> GPS در HTTPS و پس از تأیید دسترسی دستگاه فعال است.</span>
            </div>
        </section>
            </form>
        }
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-light app-button" @onclick="CloseModalAsync" disabled="@isMutating">انصراف</button>
        @if (!isLoadingEditor)
        {
            <button type="submit" form="accident-form" class="btn btn-primary app-button" disabled="@isMutating">
                @if (isMutating)
                {
                    <span class="spinner-border spinner-border-sm"></span><span>در حال ذخیره...</span>
                }
                else
                {
                    <i class="bi bi-check2-circle"></i><span>ذخیره اطلاعات</span>
                }
            </button>
        }
    </Footer>
</AppModal>

<AppModal IsOpen="deleteModalOpen" Title="حذف حادثه" Subtitle="این عملیات در API انجام می‌شود و قابل بازگشت نیست."
          Icon="bi-trash3" OnClose="CloseDeleteModal">
    <ChildContent>
        <div class="delete-confirmation">
            <span><i class="bi bi-exclamation-triangle"></i></span>
            <div><strong>از حذف این حادثه مطمئن هستید؟</strong><p>در صورت داشتن خودرو، عابر یا اطلاعات وابسته، API ممکن است حذف را رد کند.</p></div>
        </div>
        @if (!string.IsNullOrWhiteSpace(deleteError))
        {
            <div class="app-alert danger"><i class="bi bi-exclamation-circle"></i><span>@deleteError</span></div>
        }
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-light app-button" @onclick="CloseDeleteModal" disabled="@isMutating">انصراف</button>
        <button type="button" class="btn btn-danger app-button" @onclick="ConfirmDeleteAsync" disabled="@isMutating">
            @if (isMutating)
            {
                <span class="spinner-border spinner-border-sm"></span><span>در حال حذف...</span>
            }
            else
            {
                <i class="bi bi-trash3"></i><span>حذف</span>
            }
        </button>
    </Footer>
</AppModal>



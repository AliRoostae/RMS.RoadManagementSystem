    private static double? ParseCoordinate(IReadOnlyDictionary<string, string> values, string key) =>
        values.TryGetValue(key, out var value)
        && double.TryParse(value, NumberStyles.Float, CultureInfo.InvariantCulture, out var coordinate)
            ? coordinate
            : null;

    private IReadOnlyList<IReadOnlyList<MapPoint>> BuildSelectedRoadPaths()
        => selectedRoadGeometry is null ? [] : RoutePaths(selectedRoadGeometry);

    private async Task LoadSelectedRoadGeometryAsync()
    {
        selectedRoadGeometry = null;
        if (!selectedAccidentRoadId.HasValue)
            return;

        try
        {
            selectedRoadGeometry = (await RoadApi.GetGeometryAsync(selectedAccidentRoadId.Value)).Boundary;
        }
        catch (Exception exception) when (exception is ApiClientException or HttpRequestException)
        {
            locationError = ErrorMessage(exception, "دریافت هندسه راه انتخاب‌شده با خطا مواجه شد.");
        }
    }

    private static IReadOnlyList<IReadOnlyList<MapPoint>> RoutePaths(Geometry geometry)
    {
        static IReadOnlyList<MapPoint> ConvertCoordinates(Coordinate[] coordinates)
        {
            if (coordinates.Length > 1 && coordinates[0].Equals2D(coordinates[^1]))
                coordinates = coordinates[..^1];
            return coordinates
                .Select(coordinate => new MapPoint(coordinate.Y, coordinate.X))
                .ToArray();
        }

        return geometry switch
        {
            LineString lineString => [ConvertCoordinates(lineString.Coordinates)],
            MultiLineString multiLineString => Enumerable.Range(0, multiLineString.NumGeometries)
                .Select(index => (IReadOnlyList<MapPoint>)ConvertCoordinates(
                    ((LineString)multiLineString.GetGeometryN(index)).Coordinates))
                .ToArray(),
            Polygon polygon => [ConvertCoordinates(polygon.ExteriorRing.Coordinates)],
            MultiPolygon multiPolygon => Enumerable.Range(0, multiPolygon.NumGeometries)
                .Select(index => (IReadOnlyList<MapPoint>)ConvertCoordinates(
                    ((Polygon)multiPolygon.GetGeometryN(index)).ExteriorRing.Coordinates))
                .ToArray(),
            _ => [ConvertCoordinates(geometry.Coordinates)]
        };
    }

    private string GetDraft(string key) => draft.GetValueOrDefault(key, string.Empty);

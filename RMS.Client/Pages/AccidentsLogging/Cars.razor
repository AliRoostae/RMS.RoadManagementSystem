@page "/cars"
@page "/accidents/{AccidentId:guid}/cars"
@attribute [Authorize]
@using System.Globalization
@inject AccidentApiService AccidentApi
@inject CarApiService CarApi
@inject NavigationManager Navigation
@inject RmsAuthenticationStateProvider AuthenticationState

<PageTitle>@PageTitleText | راه‌بان کیان</PageTitle>

<PageHeader Title="@PageTitleText" Description="@PageDescription" Eyebrow="اطلاعات حوادث">
    <Actions>
        @if (AccidentId.HasValue)
        {
            <a class="btn btn-light app-button" href="/accidents"><i class="bi bi-arrow-right"></i> بازگشت به حوادث</a>
        }
        @if (CanCreateHere)
        {
            <button class="btn btn-primary app-button" type="button" @onclick="OpenCreate">
                <i class="bi bi-plus-lg"></i> افزودن خودرو
            </button>
        }
    </Actions>
</PageHeader>

@if (!CanList)
{
    <section class="panel-card access-denied-card">
        <span><i class="bi bi-shield-lock"></i></span>
        <h2>دسترسی به این بخش مجاز نیست</h2>
        <p>برای مشاهده فهرست خودروها باید مجوز گزارش این بخش را داشته باشید.</p>
    </section>
}
else
{
    @if (!AccidentId.HasValue)
    {
        <section class="panel-card access-denied-card image-route-guide">
            <span><i class="bi bi-car-front"></i></span>
            <h2>ابتدا حادثه را انتخاب کنید</h2>
            <p>خودروها به حادثه وابسته‌اند. برای مشاهده یا ثبت خودرو، از فهرست حوادث وارد خودروهای همان حادثه شوید.</p>
            @if (CanListAccidents)
            {
                <AccidentWizard AccidentIdChanged="HandleAccidentSelectedAsync" />
            }

     
            @if (CanListAccidents)
            {
                <a class="btn btn-primary app-button" href="/accidents"><i class="bi bi-exclamation-octagon"></i> مشاهده حوادث</a>
            }
        </section>
    }
    else
    {
        @if (ParentAccident is not null)
        {
            <section class="entity-context-card">
                <span class="entity-context-icon"><i class="bi bi-exclamation-octagon"></i></span>
                <div>
                    <small>حادثه انتخاب‌شده</small>
                    <strong>ACC-@RmsUi.ShortId(ParentAccident.Id)</strong>
                    <span>@RmsUi.DateTime(ParentAccident.AccidentTimeUnix) · @RmsUi.AccidentType(ParentAccident.AccidentType)</span>
                </div>
                @if (CanListPeople)
                {
                    <a class="btn btn-light app-button" href="@($"/accidents/{ParentAccident.Id}/people")"><i class="bi bi-person-walking"></i> افراد حادثه</a>
                }
            </section>
        }

        <EntityListPanel @key="AccidentId" @ref="listPanel" Columns="Columns" Rows="rows" IsLoading="isLoading"
                         TotalCount="totalCount" ErrorMessage="@pageError" SuccessMessage="@successMessage"
                         SearchPlaceholder="جست‌وجو با پلاک، مدل یا کلاس خودرو..." QueryChanged="LoadPageAsync">
            <RowActions Context="row">
                @if (CanListPassengers)
                {
                    <a class="table-action related" href="@($"/cars/{row.Id}/passengers")" title="راننده و سرنشینان خودرو"><i class="bi bi-people"></i></a>
                }
                @if (CanUpdate)
                {
                    <button type="button" class="table-action" title="ویرایش خودرو" @onclick="() => OpenEditAsync(row)"><i class="bi bi-pencil-square"></i></button>
                }
                @if (CanDelete)
                {
                    <button type="button" class="table-action danger" title="حذف خودرو" @onclick="() => AskDelete(row)"><i class="bi bi-trash3"></i></button>
                }
            </RowActions>
        </EntityListPanel>
    }
}

<AppModal IsOpen="modalOpen" Large="true" Title="@(editingRow is null ? "افزودن خودرو" : "ویرایش خودرو")"
          Subtitle="خودرو به حادثه جاری منتسب می‌شود و این انتساب قابل تغییر نیست." Icon="bi-car-front" OnClose="CloseModal">
    <ChildContent>
        @if (isLoadingEditor)
        {
            <div class="table-loading"><span class="spinner-border spinner-border-sm"></span> در حال دریافت جزئیات خودرو...</div>
        }
        else
        {
            @if (!string.IsNullOrWhiteSpace(mutationError))
            {
                <div class="app-alert danger"><i class="bi bi-exclamation-circle"></i><span>@mutationError</span></div>
            }
            <form id="car-form" @onsubmit="SaveAsync" @onsubmit:preventDefault="true">
                <div class="form-grid">
                    <div class="form-group">
                        <label for="car-plate">شماره پلاک</label>
                        <input id="car-plate" value="@GetDraft("Plate")" placeholder="ایران ۶۶ - ۱۲۳ ب ۴۵" required @oninput="ChangePlate" />
                    </div>    
                    <div class="form-group">
                    <label for="car-license-date">تاریخ صدور گواهینامه</label>
                    <DatePickerZO @ref="licenseDatePickerComponent" PopupDatePickerZO="true" Format="yyyy/MM/dd"
                                  SelectDate="@LicenseDatePicker" SelectDateChanged="OnLicenseDateChanged" />
                </div>
                    <div class="form-group">
                        <label for="car-name">نام یا مدل خودرو</label>
                        <input id="car-name" value="@GetDraft("Car")" placeholder="مثلاً پژو ۲۰۷" required @oninput="ChangeCarName" />
                    </div>
                    <div class="form-group">
                        <label for="car-class">رده خودرو</label>
                        <select id="car-class" value="@GetDraft("Class")" required @onchange="ChangeClass">
                            <option value="">انتخاب کنید</option>
                            @foreach (var value in Enum.GetValues<CarClassEnums>())
                            {
                                <option value="@Convert.ToByte(value)">@RmsUi.CarClass(value)</option>
                            }
                        </select>
                    </div> 
              
                    <div class="form-group">
                        <label for="car-year">سال تولید</label>
                        <input id="car-year" type="number" min="1300" max="2200" value="@GetDraft("Year")" placeholder="2024" required @oninput="ChangeYear" />
                    </div>
                    <div class="form-group">
                        <label for="car-color">رنگ</label>
                        <input id="car-color" value="@GetDraft("Color")" placeholder="سفید" @oninput="ChangeColor" />
                    </div>
                    <div class="form-group">
                        <label for="car-driver-phone">شماره تماس راننده</label>
                        <input id="car-driver-phone" type="tel" value="@GetDraft("DriverPhone")" placeholder="09121234567" required @oninput="ChangeDriverPhone" />
                    </div>
                    <div class="form-group">
                        <label for="car-license">شماره گواهینامه</label>
                        <input id="car-license" value="@GetDraft("License")" placeholder="شماره گواهینامه" required @oninput="ChangeLicense" />
                    </div>
                   
                    <div class="form-group">
                        <label for="car-license-validity">اعتبار گواهینامه (سال)</label>
                        <input id="car-license-validity" type="number" min="0" max="20" value="@GetDraft("LicenseValidity")" placeholder="5" required @oninput="ChangeLicenseValidity" />
                    </div>
                    <div class="form-group">
                        <label for="car-damage">درصد خسارت</label>
                        <input id="car-damage" type="number" min="1" max="100" value="@GetDraft("Damage")" placeholder="30" required @oninput="ChangeDamage" />
                    </div>
                </div>
            </form>
        }
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-light app-button" @onclick="CloseModal" disabled="@isMutating">انصراف</button>
        @if (!isLoadingEditor)
        {
            <button type="submit" form="car-form" class="btn btn-primary app-button" disabled="@isMutating">
                @if (isMutating)
                {
                    <span class="spinner-border spinner-border-sm"></span><span>در حال ذخیره...</span>
                }
                else
                {
                    <i class="bi bi-check2-circle"></i><span>ذخیره اطلاعات</span>
                }
            </button>
        }
    </Footer>
</AppModal>

<AppModal IsOpen="deleteModalOpen" Title="حذف خودرو" Subtitle="این عملیات در API انجام می‌شود و قابل بازگشت نیست."
          Icon="bi-trash3" OnClose="CloseDeleteModal">
    <ChildContent>
        <div class="delete-confirmation">
            <span><i class="bi bi-exclamation-triangle"></i></span>
            <div><strong>از حذف این خودرو مطمئن هستید؟</strong><p>در صورت داشتن راننده یا سرنشین، API ممکن است حذف را رد کند.</p></div>
        </div>
        @if (!string.IsNullOrWhiteSpace(deleteError))
        {
            <div class="app-alert danger"><i class="bi bi-exclamation-circle"></i><span>@deleteError</span></div>
        }
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-light app-button" @onclick="CloseDeleteModal" disabled="@isMutating">انصراف</button>
        <button type="button" class="btn btn-danger app-button" @onclick="ConfirmDeleteAsync" disabled="@isMutating">
            @if (isMutating)
            {
                <span class="spinner-border spinner-border-sm"></span><span>در حال حذف...</span>
            }
            else
            {
                <i class="bi bi-trash3"></i><span>حذف</span>
            }
        </button>
    </Footer>
</AppModal>



@page "/passengers"
@page "/cars/{CarId:guid}/passengers"
@attribute [Authorize]
@inject AccidentApiService AccidentApi
@inject CarApiService CarApi
@inject PassengerApiService PassengerApi
@inject LookupApiService LookupApi
@inject NavigationManager Navigation
@inject RmsAuthenticationStateProvider AuthenticationState

<PageTitle>@PageTitleText | راه‌بان کیان</PageTitle>

<PageHeader Title="@PageTitleText" Description="@PageDescription" Eyebrow="اطلاعات حوادث">
    <Actions>
        @if (parentCar is not null)
        {
            <a class="btn btn-light app-button" href="@($"/accidents/{parentCar.FkAccident}/cars")"><i class="bi bi-arrow-right"></i> بازگشت به خودروهای حادثه</a>
        }
        @if (CanCreateHere)
        {
            <button class="btn btn-primary app-button" type="button" @onclick="OpenCreate">
                <i class="bi bi-plus-lg"></i> افزودن راننده یا سرنشین
            </button>
        }
    </Actions>
</PageHeader>

@if (!CanList)
{
    <section class="panel-card access-denied-card">
        <span><i class="bi bi-shield-lock"></i></span>
        <h2>دسترسی به این بخش مجاز نیست</h2>
        <p>برای مشاهده رانندگان و سرنشینان باید مجوز گزارش این بخش را داشته باشید.</p>
    </section>
}
else
{
    @if (!CarId.HasValue)
    {
        <section class="panel-card access-denied-card image-route-guide">
            <span><i class="bi bi-people"></i></span>
            <h2>ابتدا خودرو را از یک حادثه انتخاب کنید</h2>
            <p>رانندگان و سرنشینان به خودرو وابسته‌اند. برای مشاهده یا ثبت اطلاعات، از فهرست حوادث وارد خودروهای همان حادثه و سپس سرنشینان خودرو شوید.</p>
            @if (CanListAccidents)
            {
                <div class="parent-lookup-guide">
                    <label>۱. انتخاب حادثه</label>
                    <AsyncLookup Value="@selectedRoad" ValueChanged="SelectRoadAsync"
                                 SearchAsync="SearchAccidentsAsync" Placeholder="حادثه را جست‌وجو کنید..." />
                </div>
                @if (!CarId.HasValue)
                {
                    <div class="parent-lookup-guide">
                        <label>۲. ماه و انتخاب حادثه</label>

                        <YearMonthZO @ref="filterMonthPickerComponent" SelectDate="@filterMonth" SelectDateChanged="OnFilterMonthChanged" />
                        @if (filterRoadId.HasValue)
                        {
                            <AsyncLookup Value="@selectedAccident" ValueChanged="SelectAccidentAsync"
                                         SearchAsync="SearchAccidentsAsync" Placeholder="حادثه را جست‌وجو کنید..." />
                        }
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(selectedAccident))
                {
                    <div class="parent-lookup-guide">
                        <label>۲. انتخاب خودرو</label>
                        <AsyncLookup Value="" ValueChanged="SelectCarAsync"
                                     SearchAsync="SearchCarsAsync" Placeholder="خودروی حادثه را جست‌وجو کنید..." />
                    </div>
                }
            }
            @if (CanListAccidents)
            {
                <a class="btn btn-primary app-button" href="/accidents"><i class="bi bi-exclamation-octagon"></i> مشاهده حوادث</a>
            }
        </section>
    }
    else
    {
        @if (parentCar is not null)
        {
            <section class="entity-context-card">
                <span class="entity-context-icon"><i class="bi bi-car-front"></i></span>
                <div>
                    <small>خودروی انتخاب‌شده</small>
                    <strong>@parentCar.PlateNumber · @parentCar.CarName</strong>
                    <span>@RmsUi.CarClass(parentCar.CarClass) · حادثه ACC-@RmsUi.ShortId(parentCar.FkAccident)</span>
                </div>
                @if (CanListPeople)
                {
                    <a class="btn btn-light app-button" href="@($"/accidents/{parentCar.FkAccident}/people")"><i class="bi bi-person-walking"></i> افراد حادثه</a>
                }
            </section>
        }

        <EntityListPanel @key="CarId" @ref="listPanel" Columns="Columns" Rows="rows" IsLoading="isLoading"
                         TotalCount="totalCount" ErrorMessage="@pageError" SuccessMessage="@successMessage"
                         SearchPlaceholder="جست‌وجو با نام، کد ملی یا نقش..." QueryChanged="LoadPageAsync">
            <RowActions Context="row">
                @if (CanUpdate)
                {
                    <button type="button" class="table-action" title="ویرایش راننده یا سرنشین" @onclick="() => OpenEditAsync(row)"><i class="bi bi-pencil-square"></i></button>
                }
                @if (CanDelete)
                {
                    <button type="button" class="table-action danger" title="حذف راننده یا سرنشین" @onclick="() => AskDelete(row)"><i class="bi bi-trash3"></i></button>
                }
            </RowActions>
        </EntityListPanel>
    }
}

<AppModal IsOpen="modalOpen" Large="true" Title="@(editingRow is null ? "افزودن راننده یا سرنشین" : "ویرایش راننده یا سرنشین")"
          Subtitle="شخص به خودرو جاری منتسب می‌شود و نیازی به انتخاب دوباره خودرو نیست." Icon="bi-people" OnClose="CloseModal">
    <ChildContent>
        @if (isLoadingEditor)
        {
            <div class="table-loading"><span class="spinner-border spinner-border-sm"></span> در حال دریافت جزئیات شخص...</div>
        }
        else
        {
            @if (!string.IsNullOrWhiteSpace(mutationError))
            {
                <div class="app-alert danger"><i class="bi bi-exclamation-circle"></i><span>@mutationError</span></div>
            }
            <form id="passenger-form" @onsubmit="SaveAsync" @onsubmit:preventDefault="true">
                <div class="form-grid">
                    <div class="form-group">
                        <label for="passenger-national-code">کد ملی</label>
                        <input id="passenger-national-code" value="@GetDraft("NationalCode")" placeholder="0012345678" required @oninput="ChangeNationalCode" />
                    </div>
                    <div class="form-group">
                        <label for="passenger-name">نام و نام خانوادگی</label>
                        <input id="passenger-name" value="@GetDraft("Name")" placeholder="نام کامل" required @oninput="ChangeName" />
                    </div>
                    <div class="form-group">
                        <label for="passenger-role">نقش</label>
                        <select id="passenger-role" value="@GetDraft("IsDriver")" required @onchange="ChangeRole">
                            <option value="">انتخاب کنید</option>
                            <option value="true">راننده</option>
                            <option value="false">سرنشین</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="passenger-gender">جنسیت</label>
                        <select id="passenger-gender" value="@GetDraft("Gender")" required @onchange="ChangeGender">
                            <option value="">انتخاب کنید</option>
                            @foreach (var value in Enum.GetValues<GenderEnums>())
                            {
                                <option value="@Convert.ToByte(value)">@RmsUi.Gender(value)</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="passenger-age">سن</label>
                        <input id="passenger-age" type="number" min="1" max="150" value="@GetDraft("Age")" placeholder="35" required @oninput="ChangeAge" />
                    </div>
                    <div class="form-group">
                        <label for="passenger-injury">درصد آسیب</label>
                        <input id="passenger-injury" type="number" min="0" max="100" value="@GetDraft("Injury")" placeholder="20" required @oninput="ChangeInjury" />
                    </div>
                    <div class="form-group">
                        <label for="passenger-damage-type">نوع آسیب</label>
                        <select id="passenger-damage-type" value="@GetDraft("DamageType")" required @onchange="ChangeDamageType">
                            <option value="">انتخاب کنید</option>
                            @foreach (var value in Enum.GetValues<DamageTypePersonEnum>())
                            {
                                <option value="@Convert.ToByte(value)">@RmsUi.DamageType(value)</option>
                            }
                        </select>
                    </div>
                    <div class="form-group full-width">
                        <label for="passenger-description">توضیحات آسیب</label>
                        <textarea id="passenger-description" rows="3" value="@GetDraft("Description")" placeholder="شرح وضعیت فرد..." @oninput="ChangeDescription"></textarea>
                    </div>
                </div>
            </form>
        }
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-light app-button" @onclick="CloseModal" disabled="@isMutating">انصراف</button>
        @if (!isLoadingEditor)
        {
            <button type="submit" form="passenger-form" class="btn btn-primary app-button" disabled="@isMutating">
                @if (isMutating)
                {
                    <span class="spinner-border spinner-border-sm"></span><span>در حال ذخیره...</span>
                }
                else
                {
                    <i class="bi bi-check2-circle"></i><span>ذخیره اطلاعات</span>
                }
            </button>
        }
    </Footer>
</AppModal>

<AppModal IsOpen="deleteModalOpen" Title="حذف راننده یا سرنشین" Subtitle="این عملیات در API انجام می‌شود و قابل بازگشت نیست."
          Icon="bi-trash3" OnClose="CloseDeleteModal">
    <ChildContent>
        <div class="delete-confirmation">
            <span><i class="bi bi-exclamation-triangle"></i></span>
            <div><strong>از حذف این شخص مطمئن هستید؟</strong><p>اطلاعات حذف‌شده قابل بازیابی نیست.</p></div>
        </div>
        @if (!string.IsNullOrWhiteSpace(deleteError))
        {
            <div class="app-alert danger"><i class="bi bi-exclamation-circle"></i><span>@deleteError</span></div>
        }
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-light app-button" @onclick="CloseDeleteModal" disabled="@isMutating">انصراف</button>
        <button type="button" class="btn btn-danger app-button" @onclick="ConfirmDeleteAsync" disabled="@isMutating">
            @if (isMutating)
            {
                <span class="spinner-border spinner-border-sm"></span><span>در حال حذف...</span>
            }
            else
            {
                <i class="bi bi-trash3"></i><span>حذف</span>
            }
        </button>
    </Footer>
</AppModal>



@code {
    [Parameter] public Guid? CarId { get; set; }

    private static readonly EntityColumn[] scopedColumns =
    [
        new("NationalCode", "کد ملی"), new("Name", "نام و نام خانوادگی"), new("Role", "نقش"),
        new("Gender", "جنسیت"), new("Injury", "آسیب")
    ];

    private readonly List<EntityRow> rows = [];
    private readonly Dictionary<string, string> draft = new(StringComparer.OrdinalIgnoreCase);
    private EntityListPanel? listPanel;
    private CarResponse? parentCar;
    private EntityRow? editingRow;
    private EntityRow? deletingRow;
    private int totalCount;
    private bool isLoading = true;
    private bool modalOpen;
    private bool deleteModalOpen;
    private bool isLoadingEditor;
    private bool isMutating;
    private string? pageError;
    private string? mutationError;
    private string? deleteError;
    private string? successMessage;

    private IReadOnlyList<EntityColumn> Columns => scopedColumns;
    private string PageTitleText => parentCar is not null
        ? $"سرنشینان {parentCar.PlateNumber}"
        : CarId.HasValue ? "رانندگان و سرنشینان خودرو" : "رانندگان و سرنشینان";
    private string PageDescription => CarId.HasValue
        ? "ثبت و مدیریت افراد همین خودرو؛ شناسه خودرو به‌صورت خودکار اعمال می‌شود."
        : "فهرست همه رانندگان و سرنشینان؛ برای ثبت شخص از صفحه خودرو وارد شوید.";

    private bool CanList => AuthenticationState.HasPermission(UserSection.Passengers, UserAccessOperation.Report);
    private bool CanCreate => AuthenticationState.HasPermission(UserSection.Passengers, UserAccessOperation.Create);
    private bool CanCreateHere => CanCreate && CarId.HasValue && parentCar is not null;
    private bool CanUpdate => AuthenticationState.HasPermission(UserSection.Passengers, UserAccessOperation.View)
        && AuthenticationState.HasPermission(UserSection.Passengers, UserAccessOperation.Update);
    private bool CanDelete => AuthenticationState.HasPermission(UserSection.Passengers, UserAccessOperation.Delete);
    private bool CanListAccidents => AuthenticationState.HasPermission(UserSection.Accidents, UserAccessOperation.Report);
    private bool CanListPeople => AuthenticationState.HasPermission(UserSection.People, UserAccessOperation.Report);
    private string selectedAccident = string.Empty;
    private string selectedRoad = string.Empty;
    private Guid? filterRoadId;
    private DateTime filterMonth = DateTime.Now;
    private YearMonthZO? filterMonthPickerComponent;

    /// <summary>راه والد را انتخاب می‌کند تا جستجوی حادثه محدود شود.</summary>
    private Task SelectRoadAsync(string value)
    {
        selectedRoad = value;
        filterRoadId = Guid.TryParse(value, out var roadId) ? roadId : null;
        selectedAccident = string.Empty;
        return Task.CompletedTask;
    }

    /// <summary>ماه فیلتر حادثه را از تقویم فارسی دریافت می‌کند.</summary>
    private Task OnFilterMonthChanged()
    {
        filterMonth = filterMonthPickerComponent?.SelectDate ?? DateTime.Now;
        selectedAccident = string.Empty;
        return Task.CompletedTask;
    }

    private Task SelectAccidentAsync(string value)
    {
        selectedAccident = value;
        return Task.CompletedTask;
    }

    private Task SelectCarAsync(string value)
    {
        if (Guid.TryParse(value, out var carId))
            Navigation.NavigateTo($"/cars/{carId}/passengers");
        return Task.CompletedTask;
    }

    private async Task<IReadOnlyList<LookupOption>> SearchAccidentsAsync(string term, CancellationToken token)
    {
        if (!filterRoadId.HasValue)
            return (await LookupApi.GetRoadsAsync(new LookupQuery { SearchTerm = term, Take = 20 }, token))
                .Select(road => new LookupOption(road.Id.ToString(), road.Name)).ToArray();
        return await AccidentFilterHelper.SearchAccidentsAsync(AccidentApi, filterRoadId, filterMonth, term, token);
    }
    /*
        (await LookupApi.GetAccidentsAsync(new AccidentLookupQuery { SearchTerm = term, Take = 20 }, token))
            .Select(accident => new LookupOption(accident.Id.ToString(), $"{accident.RoadName} · {RmsUi.DateTime(accident.AccidentTimeUnix)}"))
            .ToArray();

    */

    private async Task<IReadOnlyList<LookupOption>> SearchCarsAsync(string term, CancellationToken token)
    {
        if (!Guid.TryParse(selectedAccident, out var accidentId))
            return [];

        return (await LookupApi.GetCarsAsync(new CarLookupQuery
        {
            AccidentId = accidentId,
            SearchTerm = term,
            Take = 20
        }, token))
            .Select(car => new LookupOption(car.Id.ToString(), $"{car.PlateNumber} · {car.CarName}"))
            .ToArray();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!CanList)
        {
            isLoading = false;
            return;
        }

        parentCar = null;
        pageError = null;
        if (CarId.HasValue)
        {
            try
            {
                parentCar = await CarApi.GetByIdAsync(CarId.Value);
            }
            catch (Exception exception) when (exception is ApiClientException or HttpRequestException)
            {
                pageError = ErrorMessage(exception, "دریافت اطلاعات خودرو با خطا مواجه شد.");
                isLoading = false;
                rows.Clear();
                totalCount = 0;
                return;
            }
        }
        else
        {
            rows.Clear();
            totalCount = 0;
            isLoading = false;
            return;
        }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        pageError = null;
        try
        {
            await LoadPageCoreAsync(new EntityPageRequest(0, 20, string.Empty, CancellationToken.None));
        }
        catch (Exception exception) when (exception is ApiClientException or HttpRequestException)
        {
            pageError = ErrorMessage(exception, "دریافت رانندگان و سرنشینان از API با خطا مواجه شد.");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadPageAsync(EntityPageRequest request)
    {
        isLoading = true;
        pageError = null;
        try
        {
            await LoadPageCoreAsync(request);
        }
        catch (OperationCanceledException) when (request.CancellationToken.IsCancellationRequested)
        {
        }
        catch (Exception exception) when (exception is ApiClientException or HttpRequestException)
        {
            pageError = ErrorMessage(exception, "دریافت رانندگان و سرنشینان از API با خطا مواجه شد.");
        }
        finally
        {
            if (!request.CancellationToken.IsCancellationRequested)
                isLoading = false;
        }
    }

    private async Task LoadPageCoreAsync(EntityPageRequest request)
    {
        if (!CarId.HasValue)
        {
            rows.Clear();
            totalCount = 0;
            return;
        }

        var result = await PassengerApi.GetAllAsync(new PassengerQueries
        {
            CarId = CarId,
            Skip = request.Skip,
            Take = request.Take,
            SearchTerm = request.SearchTerm
        }, request.CancellationToken);
        rows.Clear();
        rows.AddRange(result.Items.Select(ToRow));
        totalCount = result.TotalCount;
    }

    private void OpenCreate()
    {
        if (!CanCreateHere)
            return;
        editingRow = null;
        draft.Clear();
        mutationError = null;
        isLoadingEditor = false;
        modalOpen = true;
    }

    private async Task OpenEditAsync(EntityRow row)
    {
        editingRow = row;
        draft.Clear();
        mutationError = null;
        isLoadingEditor = true;
        modalOpen = true;
        try
        {
            foreach (var item in ToDraft(await PassengerApi.GetByIdAsync(row.Id)))
                draft[item.Key] = item.Value;
        }
        catch (Exception exception) when (IsExpectedException(exception))
        {
            mutationError = ErrorMessage(exception, "دریافت جزئیات شخص با خطا مواجه شد.");
        }
        finally
        {
            isLoadingEditor = false;
        }
    }

    private void CloseModal()
    {
        if (!isMutating)
            modalOpen = false;
    }

    private async Task SaveAsync()
    {
        mutationError = null;
        isMutating = true;
        try
        {
            if (editingRow is null)
            {
                if (!CarId.HasValue)
                    throw new InvalidOperationException("ثبت راننده یا سرنشین باید از صفحه خودرو انجام شود.");
                await CreateAsync(CarId.Value, draft);
                successMessage = "راننده یا سرنشین با موفقیت برای این خودرو ثبت شد.";
            }
            else
            {
                await UpdateAsync(editingRow.Id, draft);
                successMessage = "اطلاعات شخص با موفقیت ویرایش شد.";
            }

            modalOpen = false;
            if (listPanel is not null)
                await listPanel.ReloadAsync();
            else
                await LoadAsync();
        }
        catch (Exception exception) when (IsExpectedException(exception))
        {
            mutationError = ErrorMessage(exception, "ذخیره اطلاعات شخص با خطا مواجه شد.");
        }
        finally
        {
            isMutating = false;
        }
    }

    private void AskDelete(EntityRow row)
    {
        deletingRow = row;
        deleteError = null;
        deleteModalOpen = true;
    }

    private void CloseDeleteModal()
    {
        if (!isMutating)
            deleteModalOpen = false;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (deletingRow is null)
            return;
        deleteError = null;
        isMutating = true;
        try
        {
            await PassengerApi.DeleteAsync(deletingRow.Id);
            deleteModalOpen = false;
            successMessage = "راننده یا سرنشین با موفقیت حذف شد.";
            if (listPanel is not null)
                await listPanel.ReloadAsync();
            else
                await LoadAsync();
        }
        catch (Exception exception) when (IsExpectedException(exception))
        {
            deleteError = ErrorMessage(exception, "حذف شخص با خطا مواجه شد.");
        }
        finally
        {
            isMutating = false;
        }
    }

    private Task CreateAsync(Guid carId, IReadOnlyDictionary<string, string> values) => PassengerApi.CreateAsync(new CreatePassengerCommand
    {
        FkCar = carId,
        NationalCode = FormValues.Required(values, "NationalCode", "کد ملی"),
        PassengerFullName = FormValues.Required(values, "Name", "نام و نام خانوادگی"),
        IsDriver = bool.Parse(FormValues.Required(values, "IsDriver", "نقش")),
        Gender = FormValues.Enum<GenderEnums>(values, "Gender", "جنسیت"),
        Age = FormValues.Byte(values, "Age", "سن"),
        InjuryPercentage = FormValues.Byte(values, "Injury", "درصد آسیب"),
        TypePersonDamage = FormValues.Enum<DamageTypePersonEnum>(values, "DamageType", "نوع آسیب"),
        DescriptionDamage = FormValues.Optional(values, "Description")
    });

    private Task UpdateAsync(Guid id, IReadOnlyDictionary<string, string> values) => PassengerApi.UpdateAsync(id, new UpdatePassengerCommand
    {
        Id = id,
        NationalCode = FormValues.Required(values, "NationalCode", "کد ملی"),
        PassengerFullName = FormValues.Required(values, "Name", "نام و نام خانوادگی"),
        IsDriver = bool.Parse(FormValues.Required(values, "IsDriver", "نقش")),
        Gender = FormValues.Enum<GenderEnums>(values, "Gender", "جنسیت"),
        Age = FormValues.Byte(values, "Age", "سن"),
        InjuryPercentage = FormValues.Byte(values, "Injury", "درصد آسیب"),
        TypePersonDamage = FormValues.Enum<DamageTypePersonEnum>(values, "DamageType", "نوع آسیب"),
        DescriptionDamage = FormValues.Optional(values, "Description")
    });

    private static EntityRow ToRow(PassengerListItemResponse passenger) => new()
    {
        Id = passenger.Id,
        Status = RmsUi.DamageType(passenger.DamageType),
        StatusTone = RmsUi.InjuryTone(passenger.InjuryPercentage),
        Values = new()
        {
            ["NationalCode"] = passenger.NationalCode,
            ["Name"] = passenger.FullName,
            ["Role"] = passenger.IsDriver ? "راننده" : "سرنشین",
            ["Car"] = passenger.CarPlate,
            ["Gender"] = RmsUi.Gender(passenger.Gender),
            ["Injury"] = $"{passenger.InjuryPercentage.ToString().TranslateDigits()}٪"
        }
    };

    private static IReadOnlyDictionary<string, string> ToDraft(PassengerResponse passenger) => new Dictionary<string, string>
    {
        ["NationalCode"] = passenger.NationalCode,
        ["Name"] = passenger.PassengerFullName,
        ["IsDriver"] = passenger.IsDriver ? "true" : "false",
        ["Gender"] = Convert.ToByte(passenger.Gender).ToString(),
        ["Age"] = passenger.Age.ToString(),
        ["Injury"] = passenger.InjuryPercentage.ToString(),
        ["DamageType"] = Convert.ToByte(passenger.TypePersonDamage).ToString(),
        ["Description"] = passenger.DescriptionDamage
    };

    private string GetDraft(string key) => draft.GetValueOrDefault(key, string.Empty);
    private void SetDraft(string key, object? value) => draft[key] = value?.ToString() ?? string.Empty;
    private void ChangeNationalCode(ChangeEventArgs eventArgs) => SetDraft("NationalCode", eventArgs.Value);
    private void ChangeName(ChangeEventArgs eventArgs) => SetDraft("Name", eventArgs.Value);
    private void ChangeRole(ChangeEventArgs eventArgs) => SetDraft("IsDriver", eventArgs.Value);
    private void ChangeGender(ChangeEventArgs eventArgs) => SetDraft("Gender", eventArgs.Value);
    private void ChangeAge(ChangeEventArgs eventArgs) => SetDraft("Age", eventArgs.Value);
    private void ChangeInjury(ChangeEventArgs eventArgs) => SetDraft("Injury", eventArgs.Value);
    private void ChangeDamageType(ChangeEventArgs eventArgs) => SetDraft("DamageType", eventArgs.Value);
    private void ChangeDescription(ChangeEventArgs eventArgs) => SetDraft("Description", eventArgs.Value);

    private static bool IsExpectedException(Exception exception) =>
        exception is ApiClientException or HttpRequestException or FormatException or InvalidOperationException or ArgumentException;

    private static string ErrorMessage(Exception exception, string fallback) => exception switch
    {
        ApiClientException apiException => apiException.Message,
        HttpRequestException => "ارتباط با RMS.Api برقرار نشد. از اجرا بودن سرویس مطمئن شوید.",
        _ when !string.IsNullOrWhiteSpace(exception.Message) => exception.Message,
        _ => fallback
    };
}
